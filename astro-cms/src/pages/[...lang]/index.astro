---
import { get } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Layout from '~/layouts/Layout.astro';

const { lang } = Astro.params;
const homepage = await get(keystaticConfig.singletons.homepage);

if (!homepage) {
  throw new Error('Homepage content not found');
}

const { title, description } = homepage.data;

// @ts-ignore
const pageTitle = title[lang] || title.en;
// @ts-ignore
const pageDescription = description[lang] || description.en;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-bold text-center my-8">{pageTitle}</h1>
    <p class="text-xl text-center">{pageDescription}</p>
  </div>
</Layout>
