{
    "name": "Astro Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
    "remoteUser": "node",
    "forwardPorts": [
        4321
    ],
    "portsAttributes": {
        "4321": {
            "label": "Astro Dev Server",
            "onAutoForward": "notify"
        }
    },
    "mounts": [
        "source=pnpm-store-node22,target=/home/node/.local/share/pnpm/store,type=volume"
    ],
    "postCreateCommand": "sudo corepack enable pnpm && pnpm config set store-dir /home/node/.local/share/pnpm/store && pnpm install",
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "files.associations": {
                    "*.astro": "astro"
                }
            },
            "extensions": [
                "astro-build.astro-vscode",
                "bradlc.vscode-tailwindcss",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}