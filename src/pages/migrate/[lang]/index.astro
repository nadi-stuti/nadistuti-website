                                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <h3
                                        class="text-xl font-bold text-gray-900 mb-3 text-multilang"
                                    >
                                        {
                                            data.mission_section.cards
                                                .conservation.title
                                        }
                                    </h3>
                                    <p
                                        class="text-gray-600 leading-relaxed text-multilang"
                                    >
                                        {
                                            data.mission_section.cards
                                                .conservation.description
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Community Building -->
                        <div
                            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 border border-indigo-100"
                        >
                            <div class="flex items-start space-x-4">
                                <div class="flex-shrink-0">
                                    <div
                                        class="w-12 h-12 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center"
                                    >
                                        <svg
                                            class="w-6 h-6 text-white"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <h3
                                        class="text-xl font-bold text-gray-900 mb-3 text-multilang"
                                    >
                                        {
                                            data.mission_section.cards.community
                                                .title
                                        }
                                    </h3>
                                    <p
                                        class="text-gray-600 leading-relaxed text-multilang"
                                    >
                                        {
                                            data.mission_section.cards.community
                                                .description
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Call to Action -->
                <div
                    class="text-center bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-12 text-white"
                >
                    <h3 class="text-3xl font-bold mb-4 text-multilang">
                        {data.mission_section.cta.title}
                    </h3>
                    <p
                        class="text-xl text-indigo-100 mb-8 max-w-3xl mx-auto text-multilang"
                    >
                        {data.mission_section.cta.description}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
