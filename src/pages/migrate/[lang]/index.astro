                            {data.mission_section.cta.join_button}
                        </a>
                        <a
                            href={getLocalizedPath("/contribute", currentLang)}
                            class="bg-indigo-800 text-white px-8 py-3 rounded-lg font-semibold hover:bg-indigo-900 transition-all border border-indigo-400 text-multilang"
                        >
                            {data.mission_section.cta.contribute_button}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Overview Section -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang"
