---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import AudioPlayer from "../../../components/AudioPlayer";
import { getLocalizedPath, type Language } from "../../../i18n";

export async function getStaticPaths() {
    const pages = await getCollection("homepage");
    return pages.map((page) => {
        const [lang] = page.slug.split("/");
        // If the slug is just 'en' or 'hi', use that.
        // If it was 'homepage/en', we would need to parse differently.
        // Based on my creation, the slug is just the filename 'en' or 'hi'.
        return { params: { lang: page.slug } };
    });
}

const { lang } = Astro.params;
const entry = await getEntry("homepage", lang);

if (!entry || !lang) {
    return Astro.redirect("/404");
}

// Type assertion since we've validated lang exists and is a valid homepage entry
const currentLang = lang as Language;
const { data } = entry;
---

<Layout title={data.title} description={data.subtitle} lang={currentLang}>
    <Header />

    <main class="">
        <!-- Hero Section -->
        <section
            class="relative min-h-screen flex items-center justify-center overflow-hidden selection:bg-amber-700"
        >
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img
                    src={data.hero.image}
                    alt={data.hero.alt}
                    class="w-full h-full object-cover"
                    loading="eager"
                />
                <div class="absolute inset-0 bg-black/40"></div>
            </div>

            <!-- Content -->
            <div
                class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white"
            >
                <h1
                    class="text-4xl md:text-6xl font-bold mb-6 leading-tight text-multilang"
                >
                    <span
                        class="block text-2xl md:text-3xl font-normal mb-2 text-orange-200 font-sanskrit"
                        >नदीस्तुति</span
                    >
                    {
                        data.title
                            .replace("NadiStuti - ", "")
                            .replace("नदीस्तुति - ", "")
                    }
                </h1>
                <p
                    class="text-xl md:text-2xl mb-8 text-gray-200 max-w-3xl mx-auto text-multilang"
                >
                    {data.subtitle}
                </p>

                <!-- Mission Statement -->
                <div
                    class="bg-white/10 backdrop-blur-md rounded-lg p-6 mb-8 max-w-3xl mx-auto"
                >
                    <p class="text-lg text-gray-100 text-multilang">
                        "{data.mission}"
                    </p>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href="#hymn"
                        class="bg-gradient-to-r from-amber-600 to-amber-800 hover:from-amber-700 hover:to-amber-800 text-white px-8 py-3 rounded-lg font-semibold transition-all transform hover:scale-105"
                    >
                        {data.hero.read_hymn_button}
                    </a>
                    <a
                        href={getLocalizedPath("/rivers", currentLang)}
                        class="bg-white/20 backdrop-blur-md hover:bg-white/30 text-white px-8 py-3 rounded-lg font-semibold transition-all border border-white/30"
                    >
                        {data.hero.explore_rivers_button}
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div
                class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
            >
                <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <!-- Rig Veda Hymn Section -->
        <section id="hymn" class="py-16 bg-white">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang"
                    >
                        {data.hymn.title}
                    </h2>
                    <p
                        class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang"
                    >
                        {data.hymn.description}
                    </p>
                </div>

                <!-- Audio Player -->
                <div class="mb-12">
                    <AudioPlayer client:load />
                </div>

                <!-- Sanskrit Text and Translation -->
                <div class="grid md:grid-cols-2 gap-8 mb-12">
                    <!-- Sanskrit Text -->
                    <div
                        class="bg-gradient-to-br from-orange-50 to-yellow-50 p-6 rounded-lg"
                    >
                        <h3
                            class="text-xl font-semibold text-gray-900 mb-4 text-center"
                        >
                            Sanskrit Text
                        </h3>
                        <div
                            class="space-y-4 text-lg leading-relaxed font-sanskrit text-indic"
                        >
                            {
                                data.hymn.sanskrit_text.map((text) => (
                                    <p class="text-center text-gray-800">
                                        {text}
                                    </p>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Translation -->
                    <div
                        class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-lg"
                    >
                        <h3
                            class="text-xl font-semibold text-gray-900 mb-4 text-center"
                        >
                            {data.hymn.translation_title}
                        </h3>
                        <div
                            class="space-y-4 text-gray-700 leading-relaxed text-multilang"
                        >
                            {
                                data.hymn.translation_text.map((text) => (
                                    <p>{text}</p>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Download PDF Button -->
                <div class="text-center">
                    <a
                        href="/data/stuti/rigved/nadi-stuti-hindi.pdf"
                        target="_blank"
                        class="inline-flex items-center bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white px-8 py-3 rounded-lg font-semibold transition-all transform hover:scale-105"
                    >
                        <svg
                            class="w-5 h-5 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
