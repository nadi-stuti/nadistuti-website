                            ></path>
                        </svg>
                        {data.hymn.download_pdf_button}
                    </a>
                </div>
            </div>
        </section>

        <!-- Rivers Overview Section -->
        <section class="py-16 bg-gradient-to-br from-blue-50 to-indigo-100">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang"
                    >
                        {data.rivers_section.title}
                    </h2>
                    <p
                        class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang"
                    >
                        {data.rivers_section.description}
                    </p>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
                    {
                        data.rivers_section.rivers_list.map((river) => (
                            <a
                                href={getLocalizedPath(
                                    `/rivers/${river.slug}`,
                                    currentLang,
                                )}
                                class="group bg-white rounded-lg p-4 shadow-md hover:shadow-lg transition-all transform hover:scale-105"
                            >
                                <div class="text-center">
                                    <div class="text-2xl font-sanskrit text-blue-600 mb-2 text-indic">
                                        {river.sanskrit}
                                    </div>
