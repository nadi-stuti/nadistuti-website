---
import { getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { type Language } from "../../../i18n";

export async function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "hi" } },
    ];
}

const { lang } = Astro.params;
const currentLang = lang as Language;

const entry = await getEntry("books_page", currentLang);

if (!entry) {
    return Astro.redirect("/404");
}

const { data } = entry;

const getCategoryColorClasses = (color: string) => {
    const map: Record<string, { bg: string; text: string; light: string; border: string; badge: string }> = {
        orange: { bg: "bg-orange-500", text: "text-orange-600", light: "bg-orange-50", border: "border-orange-200", badge: "bg-orange-100 text-orange-800" },
        amber:  { bg: "bg-amber-500",  text: "text-amber-600",  light: "bg-amber-50",  border: "border-amber-200",  badge: "bg-amber-100 text-amber-800"  },
        green:  { bg: "bg-green-500",  text: "text-green-600",  light: "bg-green-50",  border: "border-green-200",  badge: "bg-green-100 text-green-800"  },
        blue:   { bg: "bg-blue-500",   text: "text-blue-600",   light: "bg-blue-50",   border: "border-blue-200",   badge: "bg-blue-100 text-blue-800"    },
        red:    { bg: "bg-red-500",    text: "text-red-600",    light: "bg-red-50",    border: "border-red-200",    badge: "bg-red-100 text-red-800"      },
        purple: { bg: "bg-purple-500", text: "text-purple-600", light: "bg-purple-50", border: "border-purple-200", badge: "bg-purple-100 text-purple-800" },
    };
    return map[color] || map["blue"];
};

const getBadgeClass = (color: string) => {
    const map: Record<string, string> = {
        orange: "bg-orange-500",
        green:  "bg-emerald-500",
        blue:   "bg-blue-500",
        purple: "bg-purple-500",
        red:    "bg-red-500",
        amber:  "bg-amber-500",
    };
    return map[color] || "bg-gray-500";
};

const getStatColorClass = (color: string) => {
    const map: Record<string, string> = {
        blue:   "text-blue-600",
        orange: "text-orange-600",
        green:  "text-green-600",
        purple: "text-purple-600",
        red:    "text-red-600",
        amber:  "text-amber-600",
    };
    return map[color] || "text-gray-600";
};

const getCategoryIcon = (icon: string) => {
    const icons: Record<string, string> = {
        om: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z",
        scroll: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
        leaf: "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z",
        school: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
        exam: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
        pen: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z",
    };
    return icons[icon] || icons["scroll"];
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main class="min-h-screen bg-gray-50">
        <!-- Hero Section -->
        <section class="py-16 bg-gradient-to-r from-orange-600 to-red-700 text-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <div class="flex justify-center mb-6">
                        <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center">
                            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
                                </path>
                            </svg>
                        </div>
                    </div>
                    <h1 class="text-4xl md:text-6xl font-bold mb-6">{data.hero.title}</h1>
                    <p class="text-xl md:text-2xl mb-8 text-orange-100 max-w-4xl mx-auto">
                        {data.hero.description}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="#books"
                            class="bg-white text-orange-600 px-8 py-3 rounded-lg font-semibold hover:bg-orange-50 transition-all transform hover:scale-105">
                            {data.hero.browse_button}
                        </a>
                        <a href="#suggest"
                            class="bg-orange-800 text-white px-8 py-3 rounded-lg font-semibold hover:bg-orange-900 transition-all border border-orange-500">
                            {data.hero.suggest_button}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <section class="py-10 bg-white border-b">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    {data.stats.map((stat) => (
                        <div>
                            <div class={`text-3xl font-bold mb-2 ${getStatColorClass(stat.color)}`}>
                                {stat.value}
                            </div>
                            <div class="text-gray-600">{stat.label}</div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Search & Filter Bar (matches shop.astro style) -->
        <section class="py-8 bg-white border-b sticky top-16 z-40">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col lg:flex-row gap-4 items-center justify-between">
                    <div class="flex-1 max-w-2xl">
                        <div class="relative">
                            <input type="text" placeholder={data.search_section.placeholder}
                                class="w-full px-6 py-4 pr-12 text-lg rounded-lg border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:border-transparent shadow-sm" />
                            <button class="absolute right-3 top-3 text-gray-400 hover:text-orange-500">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="flex gap-4 flex-wrap">
                        <select class="px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                            <option value="all">{data.search_section.filter_category}</option>
                            {data.categories.map(cat => (
                                <option value={cat.id}>{cat.title}</option>
                            ))}
                        </select>
                        <select class="px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                            <option value="all">{data.search_section.filter_language}</option>
                            <option>English</option>
                            <option>Hindi</option>
                            <option>Sanskrit</option>
                        </select>
                        <select class="px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                            {data.search_section.sort_options.map(opt => (
                                <option>{opt}</option>
                            ))}
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Categories Grid -->
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                        {currentLang === "hi" ? "श्रेणियाँ" : "Browse by Category"}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {currentLang === "hi"
                            ? "अपनी रुचि के अनुसार पुस्तकें खोजें"
                            : "Find books tailored to your interest and purpose"}
                    </p>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    {data.categories.map(category => {
                        const colors = getCategoryColorClasses(category.color);
                        return (
                            <a href={`#cat-${category.id}`}
                                class={`group relative overflow-hidden rounded-2xl p-6 border-2 ${colors.border} ${colors.light} hover:shadow-xl transition-all duration-300 hover:-translate-y-1 cursor-pointer`}>
                                <div class="flex items-start space-x-4">
                                    <div class={`w-12 h-12 ${colors.bg} rounded-xl flex items-center justify-center flex-shrink-0 shadow-md group-hover:scale-110 transition-transform`}>
                                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d={getCategoryIcon(category.icon)} />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class={`font-bold text-gray-900 text-lg group-hover:${colors.text} transition-colors`}>
                                            {category.title}
                                        </h3>
                                        <p class="text-sm text-gray-600 mt-1 leading-snug">{category.description}</p>
                                        <span class={`mt-3 inline-block text-xs font-semibold px-2 py-1 rounded-full ${colors.badge}`}>
                                            {category.count}
                                        </span>
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- Featured Books -->
        <section id="books" class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                        {data.featured_books.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {data.featured_books.description}
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {data.featured_books.books.map(book => {
                        const colors = getCategoryColorClasses(book.category_color);
                        return (
                            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl border border-gray-100 transition-all duration-300 hover:-translate-y-1 flex flex-col overflow-hidden">
                                <!-- Book Cover Graphic -->
                                <div class={`relative h-48 ${colors.light} flex items-center justify-center`}>
                                    <div class={`w-28 h-36 ${colors.bg} rounded-lg shadow-2xl flex flex-col items-center justify-center p-3 group-hover:scale-105 transition-transform`}>
                                        <svg class="w-10 h-10 text-white mb-2 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
                                            </path>
                                        </svg>
                                        <span class="text-white text-xs font-semibold text-center leading-tight opacity-90">
                                            {currentLang === "hi" ? "नदी" : "River"}
                                        </span>
                                    </div>
                                    {book.badge && (
                                        <span class={`absolute top-4 left-4 text-white text-xs font-bold px-3 py-1 rounded-full shadow ${getBadgeClass(book.badge_color || "blue")}`}>
                                            {book.badge}
                                        </span>
                                    )}
                                    <span class={`absolute top-4 right-4 text-xs font-medium px-2 py-1 rounded-full ${colors.badge}`}>
                                        {book.category_label}
                                    </span>
                                </div>

                                <!-- Book Info -->
                                <div class="p-6 flex flex-col flex-1">
                                    <h3 class="text-lg font-bold text-gray-900 mb-1 line-clamp-2">{book.title}</h3>
                                    <p class={`text-sm font-medium mb-3 ${colors.text}`}>{book.author}</p>
                                    <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">{book.description}</p>

                                    <div class="flex items-center gap-4 text-xs text-gray-500 mb-5">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                                            </svg>
                                            {book.language}
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                            {book.pages}
                                        </span>
                                        <span>{book.year}</span>
                                    </div>

                                    <div class="flex gap-2 flex-wrap">
                                        {book.buy_links.map(link => (
                                            <a href={link.url} target="_blank"
                                                class={`flex-1 text-center text-sm font-semibold py-2 px-3 rounded-lg transition-all ${colors.bg} text-white hover:opacity-90 hover:shadow-md`}>
                                                {link.label}
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- Religious Books Section -->
        <section id="cat-religious" class="py-16 bg-gradient-to-br from-orange-50 to-amber-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center mb-10">
                    <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center mr-4 shadow">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
                            {currentLang === "hi" ? "धार्मिक एवं शास्त्रीय" : "Religious & Scriptural"}
                        </h2>
                        <p class="text-orange-600 text-sm font-medium mt-0.5">
                            {currentLang === "hi" ? "प्राचीन स्तोत्र और पवित्र ग्रंथ" : "Ancient hymns and sacred texts"}
                        </p>
                    </div>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {data.books_by_category.religious?.map(book => (
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-orange-100 hover:shadow-md hover:border-orange-200 transition-all group">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex-1 pr-3">
                                    <h3 class="font-bold text-gray-900 group-hover:text-orange-700 transition-colors leading-snug">
                                        {book.title}
                                    </h3>
                                    <p class="text-sm text-orange-600 mt-0.5">{book.author}</p>
                                </div>
                                {book.free_pdf && (
                                    <span class="flex-shrink-0 bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-full">
                                        FREE
                                    </span>
                                )}
                            </div>
                            <p class="text-sm text-gray-600 mb-4 leading-relaxed">{book.description}</p>
                            <div class="flex items-center gap-3 text-xs text-gray-500 mb-4">
                                <span>{book.language}</span>
                                <span>•</span>
                                <span>{book.pages}</span>
                                <span>•</span>
                                <span>{book.year}</span>
                            </div>
                            {book.free_pdf && (
                                <a href={book.free_pdf}
                                    class="w-full flex items-center justify-center gap-2 bg-orange-50 text-orange-700 border border-orange-200 hover:bg-orange-100 py-2.5 px-4 rounded-lg text-sm font-semibold transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                    {currentLang === "hi" ? "PDF डाउनलोड करें" : "Download PDF"}
                                </a>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Competitive Exams Section -->
        <section id="cat-competitive" class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center mb-10">
                    <div class="w-10 h-10 bg-red-500 rounded-lg flex items-center justify-center mr-4 shadow">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
                            {currentLang === "hi" ? "प्रतियोगी परीक्षाएं" : "Competitive Exams"}
                        </h2>
                        <p class="text-red-600 text-sm font-medium mt-0.5">
                            {currentLang === "hi" ? "UPSC, राज्य PSC और अन्य परीक्षाएं" : "UPSC, State PSC & other exams"}
                        </p>
                    </div>
                </div>

                <!-- UPSC Banner -->
                <div class="bg-gradient-to-r from-red-600 to-red-800 rounded-2xl p-6 mb-8 flex flex-col md:flex-row items-center gap-6 shadow-lg">
                    <div class="flex-1 text-white">
                        <h3 class="text-xl font-bold mb-2">
                            {currentLang === "hi"
                                ? "UPSC में नदियाँ: एक महत्वपूर्ण विषय"
                                : "Rivers in UPSC: A High-Weightage Topic"}
                        </h3>
                        <p class="text-red-100 text-sm leading-relaxed">
                            {currentLang === "hi"
                                ? "भारतीय नदियों का विषय — उनकी भूगोल, उद्गम, सहायक नदियाँ, और महत्व — UPSC प्रारंभिक और मुख्य परीक्षाओं में नियमित रूप से पूछा जाता है।"
                                : "The topic of Indian rivers — their geography, origins, tributaries, and significance — features regularly in UPSC Prelims and Mains. Being well-prepared can make a decisive difference."}
                        </p>
                    </div>
                    <div class="flex-shrink-0 flex gap-2">
                        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-5 py-4 text-center text-white">
                            <div class="text-2xl font-bold">15-20%</div>
                            <div class="text-xs text-red-200 mt-1">{currentLang === "hi" ? "भूगोल अनुभाग" : "Geography Section"}</div>
                        </div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    {data.books_by_category.competitive?.map(book => (
                        <div class="bg-white border border-red-100 rounded-xl p-6 hover:shadow-md hover:border-red-300 transition-all group flex">
                            <div class="w-14 h-20 bg-gradient-to-br from-red-500 to-red-700 rounded-lg flex-shrink-0 mr-5 flex items-center justify-center shadow-md">
                                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                        d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <div class="flex-1 flex flex-col">
                                <h3 class="font-bold text-gray-900 group-hover:text-red-700 transition-colors mb-0.5">{book.title}</h3>
                                <p class="text-sm text-red-600 mb-2">{book.author}</p>
                                <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">{book.description}</p>
                                <div class="flex items-center justify-between">
                                    <div class="flex gap-3 text-xs text-gray-500">
                                        <span>{book.language}</span>
                                        <span>• {book.pages}</span>
                                        <span>• {book.year}</span>
                                    </div>
                                    {book.buy_url && (
                                        <a href={book.buy_url} target="_blank"
                                            class="text-sm font-semibold text-white bg-red-500 hover:bg-red-600 px-4 py-1.5 rounded-lg transition-colors">
                                            {currentLang === "hi" ? "खरीदें" : "Buy Now"}
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Suggest a Book Section -->
        <section id="suggest" class="py-16 bg-gradient-to-br from-indigo-50 to-blue-100">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                        {data.contribute_section.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {data.contribute_section.description}
                    </p>
                </div>

                <div class="bg-white rounded-2xl shadow-lg p-8 border border-blue-100">
                    <form class="space-y-5" id="suggest-book-form">
                        <div class="grid md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    {data.contribute_section.fields.title}
                                </label>
                                <input type="text"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" />
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    {data.contribute_section.fields.author}
                                </label>
                                <input type="text"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" />
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    {data.contribute_section.fields.category}
                                </label>
                                <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm">
                                    <option value="">{data.search_section.filter_category}</option>
                                    {data.categories.map(cat => (
                                        <option value={cat.id}>{cat.title}</option>
                                    ))}
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    {data.contribute_section.fields.language}
                                </label>
                                <input type="text" placeholder="e.g. English, Hindi, Sanskrit"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                {data.contribute_section.fields.reason}
                            </label>
                            <textarea rows="4"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm resize-none">
                            </textarea>
                        </div>
                        <button type="submit"
                            class="w-full bg-gradient-to-r from-orange-500 to-red-500 text-white py-3.5 px-6 rounded-lg font-semibold hover:from-orange-600 hover:to-red-600 transition-all shadow-md">
                            {data.contribute_section.fields.submit}
                        </button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
