---
import { getEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../../i18n";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "hi" } }];
}

const { lang } = Astro.params;
const currentLang = lang as Language;

const entry = await getEntry("study_hub_multimedia", currentLang);

if (!entry) {
    return Astro.redirect("/404");
}

const { data } = entry;

const getTypeColorClasses = (color: string) => {
    switch (color) {
        case "blue":
            return {
                bg: "bg-blue-100", // for badge in main card
                text: "text-blue-800",
                gradient: "from-blue-400 to-blue-600", // fallback video gradient
                iconBg: "bg-red-100", // Icon container always red-ish in static? No, static varies: red-100
                iconText: "text-red-600",
            };
        case "orange":
            return {
                bg: "bg-orange-100",
                text: "text-orange-800",
                gradient: "from-orange-400 to-orange-600",
                iconBg: "bg-red-100",
                iconText: "text-red-600",
            };
        case "green":
            return {
                bg: "bg-green-100",
                text: "text-green-800",
                gradient: "from-green-400 to-green-600",
                iconBg: "bg-red-100",
                iconText: "text-red-600",
            };
        default:
            return {
                bg: "bg-gray-100",
                text: "text-gray-800",
                gradient: "from-gray-400 to-gray-600",
                iconBg: "bg-gray-100",
                iconText: "text-gray-600",
            };
    }
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main class="min-h-screen bg-gray-50">
        <!-- Breadcrumb -->
        <section class="py-4 bg-white border-b">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="flex" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-4">
                        <li>
                            <div>
                                <a
                                    href={getLocalizedPath("/", currentLang)}
                                    class="text-gray-400 hover:text-gray-500"
                                >
                                    <svg
                                        class="flex-shrink-0 h-5 w-5"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
                                        ></path>
                                    </svg>
                                    <span class="sr-only">Home</span>
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg
                                    class="flex-shrink-0 h-5 w-5 text-gray-300"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                <a
                                    href={getLocalizedPath(
                                        "/study-hub",
                                        currentLang,
                                    )}
                                    class="ml-4 text-sm font-medium text-gray-500 hover:text-gray-700"
                                >
                                    {
                                        currentLang === "hi"
                                            ? "अध्ययन केंद्र"
                                            : "Study Hub"
                                    }
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg
                                    class="flex-shrink-0 h-5 w-5 text-gray-300"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                <span
                                    class="ml-4 text-sm font-medium text-gray-900"
                                    >{data.hero.title}</span
                                >
                            </div>
                        </li>
                    </ol>
                </nav>
            </div>
        </section>

        <!-- Page Header -->
        <section
            class="py-12 bg-gradient-to-r from-red-500 to-pink-600 text-white"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center space-x-4 mb-6">
                    <div
                        class="w-16 h-16 bg-white/20 rounded-lg flex items-center justify-center"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-4xl font-bold">{data.hero.title}</h1>
                        <p class="text-xl text-red-100 mt-2">
                            {data.hero.description}
                        </p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                    {
                        data.stats.map((stat) => (
                            <div class="bg-white/10 rounded-lg p-4">
                                <div class="text-2xl font-bold">
                                    {stat.value}
                                </div>
                                <div class="text-red-100">{stat.label}</div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Search and Filters -->
        <section class="py-8 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div
                    class="flex flex-col md:flex-row gap-4 items-center justify-between"
                >
                    <div class="flex-1 max-w-lg">
                        <div class="relative">
                            <input
                                type="text"
                                placeholder={data.filter_options
                                    .search_placeholder}
                                class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                            />
                            <svg
                                class="absolute left-3 top-2.5 h-5 w-5 text-gray-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path>
                            </svg>
                        </div>
                    </div>

                    <div class="flex gap-4">
                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        >
                            {
                                data.filter_options.types.map((option) => (
                                    <option>{option}</option>
                                ))
                            }
                        </select>

                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        >
                            {
                                data.filter_options.languages.map((option) => (
                                    <option>{option}</option>
                                ))
                            }
                        </select>

                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"
                        >
                            {
                                data.filter_options.sort.map((option) => (
                                    <option>{option}</option>
                                ))
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Multimedia Grid -->
        <section class="py-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {
                        data.items.map((item) => {
                            const colors = getTypeColorClasses(item.type_color);
                            const isVideo = item.media_type === "video";
                            const coverStyle = item.cover_image
                                ? ""
                                : `bg-gradient-to-br ${item.cover_gradient}`;

                            return (
                                <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
                                    <div class={`relative h-48 ${coverStyle}`}>
                                        {item.cover_image && (
                                            <>
                                                <img
                                                    src={item.cover_image}
                                                    alt={item.title}
                                                    class="w-full h-full object-cover"
                                                />
                                                <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center">
                                                    <button class="w-16 h-16 bg-white bg-opacity-90 rounded-full flex items-center justify-center hover:bg-opacity-100 transition-all">
                                                        <svg
                                                            class="w-8 h-8 text-red-600 ml-1"
                                                            fill="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path d="M8 5v14l11-7z" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            </>
                                        )}
                                        {!item.cover_image && (
                                            <div class="text-center text-white flex flex-col items-center justify-center h-full">
                                                <svg
                                                    class="w-16 h-16 mx-auto mb-4"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                                                    />
                                                </svg>
                                                <h4 class="text-lg font-semibold">
                                                    {currentLang === "hi"
                                                        ? "ऑडियो रिकॉर्डिंग"
                                                        : "Audio Recording"}
                                                </h4>
                                            </div>
                                        )}

                                        <div class="absolute top-4 right-4">
                                            <span class="bg-red-500 text-white px-2 py-1 rounded-full text-xs">
                                                {item.label}
                                            </span>
                                        </div>
                                        <div class="absolute bottom-4 right-4">
                                            {/* This duration display is tricky as it's not in schema, assuming generic duration or reusing duration field */}
                                            {/* Static used a separate '45:32' vs '45 min'. Schema has 'duration' as string. If it's '45 min', showing it here might be repetitive if also in text below, but static does both.*/}
                                            {/* I will skip overlay duration if not available, OR check if duration format fits. */}
                                        </div>
                                    </div>

                                    <div class="p-6">
                                        <div class="flex items-start justify-between mb-4">
                                            <div
                                                class={`w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center`}
                                            >
                                                <svg
                                                    class={`w-6 h-6 text-red-600`}
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    {/* Generic icon for now, or varies by type. Static video uses play-like icon, chant uses music note like icon */}
                                                    {isVideo ? (
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                                                        />
                                                    ) : (
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                                                        />
                                                    )}
                                                </svg>
                                            </div>
                                            <span
                                                class={`text-xs ${colors.bg} ${colors.text} px-2 py-1 rounded-full`}
                                            >
                                                {item.type}
                                            </span>
                                        </div>

                                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                            {item.title}
                                        </h3>
                                        <p class="text-sm text-gray-600 mb-4">
                                            {item.description}
                                        </p>

                                        <div class="flex items-center text-xs text-gray-500 mb-4">
                                            <svg
                                                class="w-4 h-4 mr-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                                />
                                            </svg>
                                            <span class="mr-4">
                                                {item.duration}
                                            </span>
                                            <svg
                                                class="w-4 h-4 mr-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
                                                />
                                            </svg>
                                            <span>{item.language}</span>
                                        </div>

                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center text-xs text-gray-500">
                                                <svg
                                                    class="w-4 h-4 mr-1"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                                    />
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                    />
                                                </svg>
                                                <span class="mr-4">
                                                    {item.views}
                                                </span>
                                                <div class="flex text-yellow-400 mr-2">
                                                    <svg
                                                        class="w-3 h-3 fill-current"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                    <svg
                                                        class="w-3 h-3 fill-current"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                    <svg
                                                        class="w-3 h-3 fill-current"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                    <svg
                                                        class="w-3 h-3 fill-current"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                    <svg
                                                        class="w-3 h-3 text-gray-300 fill-current"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                    </svg>
                                                </div>
                                                <span>{item.rating}</span>
                                            </div>
                                            <button class="text-red-600 hover:text-red-700 font-medium text-sm">
                                                {isVideo
                                                    ? currentLang === "hi"
                                                        ? "वीडियो देखें"
                                                        : "Watch Video"
                                                    : currentLang === "hi"
                                                      ? "ऑडियो चलाएं"
                                                      : "Play Audio"}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                <!-- Pagination -->
                <div class="mt-12 flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        {
                            currentLang === "hi" ? (
                                <span>
                                    <span class="font-medium">120</span>{" "}
                                    परिणामों में से{" "}
                                    <span class="font-medium">1</span> से{" "}
                                    <span class="font-medium">3</span> दिखाया जा
                                    रहा है
                                </span>
                            ) : (
                                <span>
                                    Showing <span class="font-medium">1</span>{" "}
                                    to <span class="font-medium">3</span> of{" "}
                                    <span class="font-medium">120</span> results
                                </span>
                            )
                        }
                    </div>
                    <div class="flex items-center space-x-2">
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            {currentLang === "hi" ? "पिछला" : "Previous"}
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-md hover:bg-red-700"
                        >
                            1
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            2
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            3
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            {currentLang === "hi" ? "अगला" : "Next"}
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
