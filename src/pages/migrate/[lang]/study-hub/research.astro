---
import { getEntry, getCollection } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../../i18n";

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "hi" } }];
}

const { lang } = Astro.params;
const currentLang = lang as Language;

// Fetch page metadata from new index collection
const entry = await getEntry("study_hub_indices", `research/${currentLang}`);

if (!entry) {
    return Astro.redirect("/404");
}

const { data } = entry;

// Fetch documents from the scalable collection
const allResources = await getCollection("study_resources");
const documents = allResources
    .filter((doc) => {
        return (
            doc.data.category === "research" &&
            doc.data.language === currentLang
        );
    })
    .map((doc) => ({
        ...doc.data,
        field: doc.data.tags?.[0] || "General",
        field_color: doc.data.tags?.includes("Hydrology")
            ? "blue"
            : doc.data.tags?.includes("Anthropology")
              ? "purple"
              : doc.data.tags?.includes("Ecology")
                ? "green"
                : "orange", // Simple mapping for now
        year: doc.data.time_range || "2024",
        journal: doc.data.publisher || "Unknown Journal",
        citations: "0 citations", // Not in generic schema yet
        pdf_url: doc.data.file_path,
    }));

const getColorClasses = (color: string) => {
    switch (color) {
        case "blue":
            return {
                bg: "bg-blue-100",
                text: "text-blue-800",
                iconBg: "bg-blue-100",
                iconText: "text-blue-600",
                hoverText: "hover:text-blue-700",
                buttonText: "text-blue-600",
            };
        case "purple":
            return {
                bg: "bg-purple-100",
                text: "text-purple-800",
                iconBg: "bg-purple-100",
                iconText: "text-purple-600",
                hoverText: "hover:text-purple-700",
                buttonText: "text-purple-600",
            };
        case "green":
            return {
                bg: "bg-green-100",
                text: "text-green-800",
                iconBg: "bg-green-100",
                iconText: "text-green-600",
                hoverText: "hover:text-green-700",
                buttonText: "text-green-600",
            };
        case "orange":
            return {
                bg: "bg-orange-100",
                text: "text-orange-800",
                iconBg: "bg-orange-100",
                iconText: "text-orange-600",
                hoverText: "hover:text-orange-700",
                buttonText: "text-orange-600",
            };
        case "red":
            return {
                bg: "bg-red-100",
                text: "text-red-800",
                iconBg: "bg-red-100",
                iconText: "text-red-600",
                hoverText: "hover:text-red-700",
                buttonText: "text-red-600",
            };
        case "teal":
            return {
                bg: "bg-teal-100",
                text: "text-teal-800",
                iconBg: "bg-teal-100",
                iconText: "text-teal-600",
                hoverText: "hover:text-teal-700",
                buttonText: "text-teal-600",
            };
        default:
            return {
                bg: "bg-gray-100",
                text: "text-gray-800",
                iconBg: "bg-gray-100",
                iconText: "text-gray-600",
                hoverText: "hover:text-gray-700",
                buttonText: "text-gray-600",
            };
    }
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main class="min-h-screen bg-gray-50">
        <!-- Breadcrumb -->
        <section class="py-4 bg-white border-b">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="flex" aria-label="Breadcrumb">
                    <ol class="flex items-center space-x-4">
                        <li>
                            <div>
                                <a
                                    href={getLocalizedPath("/", currentLang)}
                                    class="text-gray-400 hover:text-gray-500"
                                >
                                    <svg
                                        class="flex-shrink-0 h-5 w-5"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
                                        ></path>
                                    </svg>
                                    <span class="sr-only">Home</span>
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg
                                    class="flex-shrink-0 h-5 w-5 text-gray-300"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                <a
                                    href={getLocalizedPath(
                                        "/study-hub",
                                        currentLang,
                                    )}
                                    class="ml-4 text-sm font-medium text-gray-500 hover:text-gray-700"
                                >
                                    {
                                        currentLang === "hi"
                                            ? "अध्ययन केंद्र"
                                            : "Study Hub"
                                    }
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <svg
                                    class="flex-shrink-0 h-5 w-5 text-gray-300"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                <span
                                    class="ml-4 text-sm font-medium text-gray-900"
                                    >{data.hero.title}</span
                                >
                            </div>
                        </li>
                    </ol>
                </nav>
            </div>
        </section>

        <!-- Page Header -->
        <section
            class="py-12 bg-gradient-to-r from-green-500 to-teal-600 text-white"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center space-x-4 mb-6">
                    <div
                        class="w-16 h-16 bg-white/20 rounded-lg flex items-center justify-center"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-4xl font-bold">{data.hero.title}</h1>
                        <p class="text-xl text-green-100 mt-2">
                            {data.hero.description}
                        </p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                    {
                        data.stats.map((stat) => (
                            <div class="bg-white/10 rounded-lg p-4">
                                <div class="text-2xl font-bold">
                                    {stat.value}
                                </div>
                                <div class="text-green-100">{stat.label}</div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Search and Filters -->
        <section class="py-8 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div
                    class="flex flex-col md:flex-row gap-4 items-center justify-between"
                >
                    <div class="flex-1 max-w-lg">
                        <div class="relative">
                            <input
                                type="text"
                                placeholder={data.filter_options
                                    .search_placeholder}
                                class="w-full px-4 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                            />
                            <svg
                                class="absolute left-3 top-2.5 h-5 w-5 text-gray-400"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path>
                            </svg>
                        </div>
                    </div>

                    <div
                        class="flex gap-4 overflow-x-auto pb-2 md:pb-0 w-full md:w-auto"
                    >
                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                        >
                            {
                                data.filter_options?.categories?.map(
                                    (option) => <option>{option}</option>,
                                )
                            }
                        </select>

                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                        >
                            {
                                data.filter_options?.periods?.map((option) => (
                                    <option>{option}</option>
                                ))
                            }
                        </select>

                        <select
                            class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                        >
                            {
                                data.filter_options?.sort?.map((option) => (
                                    <option>{option}</option>
                                ))
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Documents Grid -->
        <section class="py-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {
                        documents.map((doc, index) => {
                            const colors = getColorClasses(doc.field_color);
                            return (
                                <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6">
                                    <div class="flex items-start justify-between mb-4">
                                        <div
                                            class={`w-12 h-12 ${colors.iconBg} rounded-lg flex items-center justify-center`}
                                        >
                                            <svg
                                                class={`w-6 h-6 ${colors.iconText}`}
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                                />
                                            </svg>
                                        </div>
                                        <span
                                            class={`text-xs ${colors.bg} ${colors.text} px-2 py-1 rounded-full`}
                                        >
                                            {doc.field}
                                        </span>
                                    </div>

                                    <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                        {doc.title}
                                    </h3>
                                    <p class="text-sm text-gray-600 mb-3">
                                        {doc.description}
                                    </p>

                                    <div class="text-xs text-gray-500 mb-3">
                                        <p class="font-medium">{doc.author}</p>
                                        <p>
                                            {doc.journal} • {doc.year}
                                        </p>
                                    </div>

                                    <div class="flex items-center text-xs text-gray-500 mb-4">
                                        <svg
                                            class="w-4 h-4 mr-1"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M8 7V3a1 1 0 011-1h6a1 1 0 011 1v4m-6 0h6m-6 0V7a1 1 0 00-1 1v10a1 1 0 001 1h8a1 1 0 001-1V8a1 1 0 00-1-1h-1"
                                            />
                                        </svg>
                                        <span class="mr-4">{doc.pages}</span>
                                        <svg
                                            class="w-4 h-4 mr-1"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                            />
                                        </svg>
                                        <span>{doc.citations}</span>
                                    </div>

                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center text-xs text-gray-500">
                                            <svg
                                                class="w-4 h-4 mr-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                                />
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                />
                                            </svg>
                                            <span class="mr-4">
                                                {doc.views}
                                            </span>
                                            <svg
                                                class="w-4 h-4 mr-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                                                />
                                            </svg>
                                            <span>{doc.likes}</span>
                                        </div>
                                        {doc.pdf_url && (
                                            <a
                                                href={doc.pdf_url}
                                                target="_blank"
                                                class={`${colors.buttonText} ${colors.hoverText} font-medium text-sm`}
                                            >
                                                {currentLang === "hi"
                                                    ? "पीडीएफ डाउनलोड करें"
                                                    : "Download PDF"}
                                            </a>
                                        )}
                                        {!doc.pdf_url && (
                                            <span class="text-gray-400 text-sm cursor-not-allowed">
                                                {currentLang === "hi"
                                                    ? "अनुपलब्ध"
                                                    : "Unavailable"}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>

                <!-- Pagination -->
                <div class="mt-12 flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        {
                            currentLang === "hi" ? (
                                <span>
                                    <span class="font-medium">150</span>{" "}
                                    परिणामों में से{" "}
                                    <span class="font-medium">1</span> से{" "}
                                    <span class="font-medium">6</span> दिखाया जा
                                    रहा है
                                </span>
                            ) : (
                                <span>
                                    Showing <span class="font-medium">1</span>{" "}
                                    to <span class="font-medium">6</span> of{" "}
                                    <span class="font-medium">150</span> results
                                </span>
                            )
                        }
                    </div>
                    <div class="flex items-center space-x-2">
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            {currentLang === "hi" ? "पिछला" : "Previous"}
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-white bg-green-600 border border-transparent rounded-md hover:bg-green-700"
                        >
                            1
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            2
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            3
                        </button>
                        <button
                            class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                        >
                            {currentLang === "hi" ? "अगला" : "Next"}
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
