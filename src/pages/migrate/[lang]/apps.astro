---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../i18n";

export async function getStaticPaths() {
    const pages = await getCollection("apps_page");
    return pages.map((page) => {
        return { params: { lang: page.id } };
    });
}

const { lang } = Astro.params;
const entry = await getEntry("apps_page", lang);

if (!entry || !lang) {
    return Astro.redirect("/404");
}

const currentLang = lang as Language;
const { data } = entry;

const getIconPath = (iconType: string) => {
    const icons = {
        quiz: "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
        memory: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
        location:
            "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z",
        sound: "M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z",
        book: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
    };
    return icons[iconType as keyof typeof icons] || icons.quiz;
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main class="min-h-screen bg-gray-50">
        <!-- Hero Section -->
        <section
            class="py-16 bg-gradient-to-r from-purple-600 to-indigo-700 text-white"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <div class="flex justify-center mb-6">
                        <div
                            class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-10 h-10 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                    </div>
                    <h1 class="text-4xl md:text-6xl font-bold mb-6">
                        {data.hero.title}
                    </h1>
                    <p
                        class="text-xl md:text-2xl mb-8 text-purple-100 max-w-4xl mx-auto"
                    >
                        {data.hero.description}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a
                            href="#apps"
                            class="bg-white text-purple-600 px-8 py-3 rounded-lg font-semibold hover:bg-purple-50 transition-all transform hover:scale-105"
                        >
                            {data.hero.browse_apps_button}
                        </a>
                        <a
                            href="#contribute"
                            class="bg-purple-800 text-white px-8 py-3 rounded-lg font-semibold hover:bg-purple-900 transition-all border border-purple-500"
                        >
                            {data.hero.contribute_button}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Apps Section -->
        <section id="apps" class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        {data.apps_section.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {data.apps_section.description}
                    </p>
                </div>

                <!-- Apps Grid -->
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {
                        data.apps_section.apps.map((app) => (
                            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                                <div
                                    class={`h-48 bg-gradient-to-br ${app.gradient} flex items-center justify-center`}
                                >
                                    <div class="text-white text-center">
                                        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <svg
                                                class="w-8 h-8"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d={getIconPath(app.icon)}
                                                />
                                            </svg>
                                        </div>
                                        <h3 class="text-xl font-bold">
                                            {app.short_title}
                                        </h3>
                                    </div>
                                </div>
                                <div class="p-6">
                                    <h3 class="text-xl font-semibold text-gray-900 mb-3">
                                        {app.title}
                                    </h3>
                                    <p class="text-gray-600 mb-4 text-sm">
                                        {app.description}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        {app.tags.map((tag) => (
                                            <span
                                                class={`px-2 py-1 bg-${tag.color}-100 text-${tag.color}-800 text-xs rounded-full`}
                                            >
                                                {tag.label}
                                            </span>
                                        ))}
                                    </div>
                                    <div class="flex space-x-3">
                                        {app.platforms.includes("ios") && (
                                            <a
                                                href="#"
                                                class="flex-1 bg-black text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-gray-800 transition-colors"
                                            >
                                                <div class="flex items-center justify-center space-x-2">
                                                    <svg
                                                        class="w-4 h-4"
                                                        viewBox="0 0 24 24"
                                                        fill="currentColor"
                                                    >
                                                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
                                                    </svg>
                                                    <span>
                                                        {
                                                            data.platform_labels
                                                                .ios
                                                        }
                                                    </span>
                                                </div>
                                            </a>
                                        )}
                                        {app.platforms.includes("android") && (
                                            <a
                                                href="#"
                                                class="flex-1 bg-green-600 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors"
                                            >
                                                <div class="flex items-center justify-center space-x-2">
                                                    <svg
                                                        class="w-4 h-4"
                                                        viewBox="0 0 24 24"
                                                        fill="currentColor"
                                                    >
                                                        <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z" />
                                                    </svg>
                                                    <span>
                                                        {
                                                            data.platform_labels
                                                                .android
                                                        }
                                                    </span>
                                                </div>
                                            </a>
                                        )}
                                        {app.platforms.includes("web") && (
                                            <a
                                                href="#"
                                                class="flex-1 bg-blue-600 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors"
                                            >
                                                <div class="flex items-center justify-center space-x-2">
                                                    <svg
                                                        class="w-4 h-4"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"
                                                        />
                                                    </svg>
                                                    <span>
                                                        {
                                                            data.platform_labels
                                                                .web
                                                        }
                                                    </span>
                                                </div>
                                            </a>
                                        )}
                                        {app.platforms.includes("download") && (
                                            <a
                                                href="#"
                                                class="flex-1 bg-gray-600 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors"
                                            >
                                                <div class="flex items-center justify-center space-x-2">
                                                    <svg
                                                        class="w-4 h-4"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                                        />
                                                    </svg>
                                                    <span>
                                                        {
                                                            data.platform_labels
                                                                .download
                                                        }
                                                    </span>
                                                </div>
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Open Source Section -->
                <div id="contribute" class="mt-16">
                    <div
                        class="bg-gradient-to-r from-green-600 to-teal-600 text-white p-8 rounded-xl"
                    >
                        <div class="text-center mb-8">
                            <div
                                class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-6"
                            >
                                <svg
                                    class="w-8 h-8 text-white"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                                    ></path>
                                </svg>
                            </div>
                            <h2 class="text-3xl font-bold mb-4">
                                {data.open_source_section.title}
                            </h2>
                            <p
                                class="text-green-100 mb-8 max-w-3xl mx-auto text-lg"
                            >
                                {data.open_source_section.description}
                            </p>
                        </div>

                        <div class="text-center">
                            <h3 class="text-xl font-bold mb-4">
                                {data.open_source_section.get_started_title}
                            </h3>
                            <div
                                class="flex flex-col sm:flex-row gap-4 justify-center"
                            >
                                <a
                                    href="https://github.com/nadi-stuti"
                                    class="bg-white/20 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/30 transition-colors flex items-center justify-center"
                                >
                                    <svg
                                        class="w-5 h-5 mr-2"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                                        ></path>
                                    </svg>
                                    {
                                        data.open_source_section
                                            .view_github_button
                                    }
                                </a>
                                <a
                                    href={getLocalizedPath(
                                        "/community",
                                        currentLang,
                                    )}
                                    class="bg-white text-green-600 px-6 py-3 rounded-lg font-semibold hover:bg-green-50 transition-colors"
                                >
                                    {
                                        data.open_source_section
                                            .join_community_button
                                    }
                                </a>
                                <a
                                    href="mailto:developers@nadistuti.com"
                                    class="bg-green-800 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-900 transition-colors border border-green-500"
                                >
                                    {
                                        data.open_source_section
                                            .contact_developers_button
                                    }
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coming Soon Section -->
                <div class="mt-16 text-center">
                    <div
                        class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white p-8 rounded-xl"
                    >
                        <h2 class="text-2xl font-bold mb-4">
                            {data.coming_soon_section.title}
                        </h2>
                        <p class="text-indigo-100 mb-6 max-w-2xl mx-auto">
                            {data.coming_soon_section.description}
                        </p>
                        <div
                            class="flex flex-col sm:flex-row gap-4 justify-center"
                        >
                            <a
                                href={getLocalizedPath(
                                    "/community",
                                    currentLang,
                                )}
                                class="bg-white text-indigo-600 px-6 py-3 rounded-lg font-semibold hover:bg-indigo-50 transition-colors"
                            >
                                {data.coming_soon_section.join_community_button}
                            </a>
                            <a
                                href="mailto:apps@nadistuti.com"
                                class="bg-indigo-700 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-800 transition-colors"
                            >
                                {data.coming_soon_section.suggest_app_button}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
