---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../i18n";

export async function getStaticPaths() {
    const pages = await getCollection("events_page");
    return pages.map((page) => {
        const [lang] = page.id.split("/");
        return { params: { lang } };
    });
}

const { lang } = Astro.params;
const entry = await getEntry("events_page", lang);

if (!entry || !lang) {
    return Astro.redirect("/404");
}

const currentLang = lang as Language;
const { data } = entry;

// Helper functions
const formatDate = (dateString: string, locale: string = 'en-US') => {
    const langLocales: Record<string, string> = { en: 'en-US', hi: 'hi-IN' };
    return new Date(dateString).toLocaleDateString(langLocales[locale] || 'en-US', {
        month: 'short', day: 'numeric', year: 'numeric'
    });
};

const getCategoryGradient = (category: string) => {
    const gradients: Record<string, string> = {
        conservation: 'from-green-500 to-teal-500',
        spiritual: 'from-orange-500 to-red-500',
        education: 'from-blue-500 to-purple-500',
        tourism: 'from-purple-500 to-pink-500',
        community: 'from-pink-500 to-rose-500',
        featured: 'from-yellow-500 to-amber-500'
    };
    return gradients[category] || 'from-gray-500 to-gray-600';
};

const getCategoryBadge = (category: string) => {
    const badges: Record<string, string> = {
        conservation: 'bg-green-100 text-green-800',
        spiritual: 'bg-orange-100 text-orange-800',
        education: 'bg-blue-100 text-blue-800',
        tourism: 'bg-purple-100 text-purple-800',
        community: 'bg-pink-100 text-pink-800',
        featured: 'bg-yellow-100 text-yellow-800'
    };
    return badges[category] || 'bg-gray-100 text-gray-800';
};

const getCategoryButton = (category: string) => {
    const classes: Record<string, string> = {
        conservation: 'bg-green-600 hover:bg-green-700',
        spiritual: 'bg-orange-600 hover:bg-orange-700',
        education: 'bg-blue-600 hover:bg-blue-700',
        tourism: 'bg-purple-600 hover:bg-purple-700',
        community: 'bg-pink-600 hover:bg-pink-700',
        featured: 'bg-yellow-600 hover:bg-yellow-700'
    };
    return classes[category] || 'bg-gray-600 hover:bg-gray-700';
};

const getCategoryBorder = (category: string) => {
    const borders: Record<string, string> = {
        conservation: 'border-green-200',
        spiritual: 'border-orange-200',
        education: 'border-blue-200',
        tourism: 'border-purple-200',
        community: 'border-pink-200',
        featured: 'border-yellow-200'
    };
    return borders[category] || 'border-gray-200';
};

const getColorIcon = (color: string) => {
    const colors: Record<string, string> = {
        green: 'bg-green-100 text-green-600',
        blue: 'bg-blue-100 text-blue-600',
        orange: 'bg-orange-100 text-orange-600',
        purple: 'bg-purple-100 text-purple-600',
        pink: 'bg-pink-100 text-pink-600',
        yellow: 'bg-yellow-100 text-yellow-600'
    };
    return colors[color] || 'bg-gray-100 text-gray-600';
};

const getContactColor = (color: string) => {
    const colors: Record<string, string> = {
        blue: 'bg-blue-100 text-blue-600',
        green: 'bg-green-100 text-green-600',
        purple: 'bg-purple-100 text-purple-600',
        orange: 'bg-orange-100 text-orange-600'
    };
    return colors[color] || 'bg-gray-100 text-gray-600';
};

const getContactLink = (color: string) => {
    const colors: Record<string, string> = {
        blue: 'text-blue-600 hover:text-blue-700',
        green: 'text-green-600 hover:text-green-700',
        purple: 'text-purple-600 hover:text-purple-700',
        orange: 'text-orange-600 hover:text-orange-700'
    };
    return colors[color] || 'text-gray-600 hover:text-gray-700';
};

const getStatusBadge = (status: string) => {
    const badges: Record<string, string> = {
        completed: 'bg-green-100 text-green-800',
        featured: 'bg-blue-100 text-blue-800',
        trending: 'bg-purple-100 text-purple-800'
    };
    return badges[status] || 'bg-gray-100 text-gray-800';
};

// JSON-LD structured data for events
const structuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": data.title,
    "description": data.description,
    "mainEntity": {
        "@type": "ItemList",
        "itemListElement": data.upcoming_events.map((event, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "item": {
                "@type": "Event",
                "name": event.title,
                "description": event.description,
                "startDate": event.date,
                "location": { "@type": "Place", "name": event.location },
                "organizer": { "@type": "Organization", "name": event.organizer },
                "offers": event.price === 0 ? { "@type": "Offer", "price": "0", "priceCurrency": "INR" } : { "@type": "Offer", "price": String(event.price), "priceCurrency": event.currency }
            }
        }))
    }
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="relative py-24 md:py-32 bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 overflow-hidden">
            <div class="absolute inset-0 bg-[url('/images/pattern-waves.svg')] bg-repeat opacity-10"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-blue-900/50 to-transparent"></div>
            <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
                <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight text-multilang">
                    <span class="block text-2xl md:text-3xl font-normal mb-2 text-blue-200 font-sanskrit">नदीस्तुति</span>
                    {data.hero.title}
                </h1>
                <p class="text-xl md:text-2xl mb-10 text-blue-100 max-w-3xl mx-auto text-multilang">
                    {data.hero.description}
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#upcoming" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white px-8 py-3 rounded-lg font-semibold transition-all transform hover:scale-105">
                        {data.hero.view_upcoming_button}
                    </a>
                    <a href="#booking" class="bg-white/20 backdrop-blur-md hover:bg-white/30 text-white px-8 py-3 rounded-lg font-semibold transition-all border border-white/30">
                        {data.hero.book_activities_button}
                    </a>
                </div>
            </div>
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>

        <!-- Categories Section -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang">{data.ui_labels.categories_title}</h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang">{data.ui_labels.categories_description}</p>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
                    {data.categories.map((cat) => (
                        <a
                            href={`/${lang}/events/allEvents?category=${cat.id}`}
                            class={`text-center p-6 rounded-xl border-2 ${getCategoryBorder(cat.id)} hover:shadow-lg transition-all group no-underline`}
                        >
                            <div class={`w-16 h-16 ${getColorIcon(cat.color)} rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform`}>
                                {cat.icon === 'heart' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>}
                                {cat.icon === 'book' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>}
                                {cat.icon === 'flame' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path></svg>}
                                {cat.icon === 'navigation' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21l1.9-5.7a8.5 8.5 0 1113.8 0z"></path></svg>}
                                {cat.icon === 'users' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>}
                                {cat.icon === 'star' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>}
                            </div>
                            <h3 class="font-semibold text-gray-900 mb-2 text-sm text-multilang">{cat.name}</h3>
                            <p class="text-xs text-gray-600 text-multilang line-clamp-2">{cat.description}</p>
                            <span class="mt-3 inline-block text-xs font-medium text-blue-600 group-hover:underline">
                                {data.ui_labels.view_details} →
                            </span>
                        </a>
                    ))}
                </div>

                <!-- View All Events CTA -->
                <div class="text-center mt-10">
                    <a
                        href={`/${lang}/events/allEvents`}
                        class="inline-flex items-center gap-2 bg-gray-900 hover:bg-gray-700 text-white px-7 py-3 rounded-lg font-semibold transition-all"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                        {data.ui_labels.view_all_events}
                    </a>
                </div>
            </div>
        </section>

        <!-- Upcoming Events Section -->
        <section id="upcoming" class="py-16 bg-gradient-to-br from-blue-50 to-indigo-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang">{data.ui_labels.upcoming_title}</h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang">{data.ui_labels.upcoming_description}</p>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {data.upcoming_events.map((event) => {
                        const availableSpots = event.capacity - event.registered;
                        return (
                            <a href={`/${lang}/events/${event.id}`} class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all transform hover:-translate-y-1 block">
                                <div class={`h-48 bg-gradient-to-r ${getCategoryGradient(event.category)} flex items-center justify-center`}>
                                    <div class="text-center text-white">
                                        <svg class="w-16 h-16 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        <div class="text-sm font-medium uppercase tracking-wider">{event.category}</div>
                                    </div>
                                </div>
                                <div class="p-6">
                                    <div class="flex items-center justify-between mb-3">
                                        <span class={`${getCategoryBadge(event.category)} text-xs font-medium px-2.5 py-0.5 rounded`}>
                                            {event.category.charAt(0).toUpperCase() + event.category.slice(1)}
                                        </span>
                                        {event.featured && (
                                            <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded">★ Featured</span>
                                        )}
                                    </div>
                                    <h3 class="text-xl font-semibold text-gray-900 mb-2 line-clamp-2 text-multilang">{event.title}</h3>
                                    <p class="text-gray-600 mb-4 line-clamp-3 text-multilang">{event.description}</p>
                                    <div class="space-y-2 mb-4">
                                        <div class="flex items-center text-sm text-gray-500">
                                            <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            <span>{formatDate(event.date, lang)}</span>
                                            {event.time && (
                                                <span class="ml-3 flex items-center">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                    {event.time}
                                                </span>
                                            )}
                                        </div>
                                        <div class="flex items-center text-sm text-gray-500">
                                            <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <span class="text-multilang">{event.location}</span>
                                        </div>
                                        <div class="flex items-center text-sm text-gray-500">
                                            <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                            <span>{availableSpots} {data.ui_labels.spots_available}</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <div class="text-lg font-bold text-gray-900">
                                            {event.price === 0 ? data.ui_labels.free : `₹${event.price}`}
                                        </div>
                                        <span class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors text-white ${getCategoryButton(event.category)}`}>
                                            {availableSpots === 0 ? data.ui_labels.sold_out :
                                             event.price === 0 ? data.ui_labels.register_free : `${data.ui_labels.book_now} ₹${event.price}`}
                                        </span>
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- Past Events Section (Carousel) -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang">{data.ui_labels.past_events_title}</h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang">{data.ui_labels.past_events_description}</p>
                </div>
                <div class="relative" id="past-events-carousel">
                    <div class="overflow-hidden rounded-xl">
                        <div class="flex transition-transform duration-500" id="carousel-track">
                            {data.recent_events.map((event) => (
                                <div class="w-full flex-shrink-0 px-2">
                                    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
                                        <div class={`h-56 bg-gradient-to-r ${getCategoryGradient(event.category)} flex items-center justify-center`}>
                                            <div class="text-center text-white p-6">
                                                <h3 class="text-2xl font-bold mb-2 text-multilang">{event.title}</h3>
                                                <p class="text-white/80">{formatDate(event.date, lang)} • {event.location}</p>
                                            </div>
                                        </div>
                                        <div class="p-6">
                                            <p class="text-gray-600 mb-6 text-multilang">{event.description}</p>
                                            {event.impact_items && (
                                                <div class="grid grid-cols-3 gap-4 mb-4">
                                                    {event.impact_items.map((item) => (
                                                        <div class="text-center bg-blue-50 rounded-lg p-3">
                                                            <div class="text-lg font-bold text-blue-700">{item.value}</div>
                                                            <div class="text-xs text-gray-600 text-multilang">{item.label}</div>
                                                        </div>
                                                    ))}
                                                </div>
                                            )}
                                            <div class="flex items-center text-sm text-gray-500">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                                <span>{event.participants} {data.ui_labels.participants}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                    <button id="carousel-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 bg-white shadow-lg rounded-full p-3 hover:bg-gray-50 transition-colors z-10">
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button id="carousel-next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 bg-white shadow-lg rounded-full p-3 hover:bg-gray-50 transition-colors z-10">
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- Booking Section -->
        <section id="booking" class="py-16 bg-gradient-to-br from-blue-50 to-cyan-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-multilang">{data.booking_section.title}</h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto text-multilang">{data.booking_section.description}</p>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    {data.booking_section.activities.map((activity) => (
                        <div class="bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-all border border-blue-100">
                            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-4">
                                {activity.icon === 'navigation' && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21l1.9-5.7a8.5 8.5 0 1113.8 0z"></path></svg>}
                                {activity.icon === 'flame' && <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path></svg>}
