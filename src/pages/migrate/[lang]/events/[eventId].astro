---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../../i18n";

export async function getStaticPaths() {
    const pages = await getCollection("events_page");
    const paths: any[] = [];

    for (const page of pages) {
        const [lang] = page.id.split("/");
        const { data } = page;

        // Generate paths for all upcoming events
        for (const event of data.upcoming_events) {
            paths.push({
                params: { lang, eventId: event.id },
                props: { event, pageData: data, lang }
            });
        }

        // Generate paths for recent events too
        for (const event of data.recent_events) {
            paths.push({
                params: { lang, eventId: event.id },
                props: { event, pageData: data, lang, isPast: true }
            });
        }
    }

    return paths;
}

const { event, pageData, lang, isPast } = Astro.props;
const currentLang = lang as Language;

const formatDate = (dateString: string, locale: string = 'en-US') => {
    const langLocales: Record<string, string> = { en: 'en-US', hi: 'hi-IN' };
    return new Date(dateString).toLocaleDateString(langLocales[locale] || 'en-US', {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
    });
};

const getCategoryGradient = (category: string) => {
    const gradients: Record<string, string> = {
        conservation: 'from-green-500 to-teal-500',
        spiritual: 'from-orange-500 to-red-500',
        education: 'from-blue-500 to-purple-500',
        tourism: 'from-purple-500 to-pink-500',
        community: 'from-pink-500 to-rose-500'
    };
    return gradients[category] || 'from-gray-500 to-gray-600';
};

const getCategoryBadge = (category: string) => {
    const badges: Record<string, string> = {
        conservation: 'bg-green-100 text-green-800',
        spiritual: 'bg-orange-100 text-orange-800',
        education: 'bg-blue-100 text-blue-800',
        tourism: 'bg-purple-100 text-purple-800',
        community: 'bg-pink-100 text-pink-800'
    };
    return badges[category] || 'bg-gray-100 text-gray-800';
};

const getCategoryButton = (category: string) => {
    const classes: Record<string, string> = {
        conservation: 'bg-green-600 hover:bg-green-700',
        spiritual: 'bg-orange-600 hover:bg-orange-700',
        education: 'bg-blue-600 hover:bg-blue-700',
        tourism: 'bg-purple-600 hover:bg-purple-700',
        community: 'bg-pink-600 hover:bg-pink-700'
    };
    return classes[category] || 'bg-gray-600 hover:bg-gray-700';
};

const ui = pageData.ui_labels;

// JSON-LD structured data for this specific event
const eventStructuredData = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": event.title,
    "description": event.description,
    "startDate": event.date,
    ...(event.end_date && { "endDate": event.end_date }),
    "location": {
        "@type": "Place",
        "name": event.location
    },
    "organizer": {
        "@type": "Organization",
        "name": event.organizer || event.organizer_name || "NadiStuti"
    },
    ...(event.price !== undefined && {
        "offers": {
            "@type": "Offer",
            "price": String(event.price),
            "priceCurrency": event.currency || "INR",
            "availability": (event.capacity - event.registered) > 0 ? "https://schema.org/InStock" : "https://schema.org/SoldOut"
        }
    })
};
---

<Layout title={`${event.title} - ${pageData.title}`} description={event.description} lang={currentLang}>
    <Header />

    <main>
        <!-- Event Hero -->
        <section class={`relative py-20 md:py-28 bg-gradient-to-br ${getCategoryGradient(event.category)} overflow-hidden`}>
            <div class="absolute inset-0 bg-black/20"></div>
            <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
                <!-- Breadcrumb -->
                <nav class="mb-6">
                    <a href={`/${lang}/events`} class="text-white/80 hover:text-white transition-colors inline-flex items-center text-sm">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        <span class="text-multilang">{ui.back_to_events}</span>
                    </a>
                </nav>

                <span class={`inline-block ${getCategoryBadge(event.category)} text-sm font-medium px-3 py-1 rounded-full mb-4`}>
                    {event.category.charAt(0).toUpperCase() + event.category.slice(1)}
                </span>

                <h1 class="text-3xl md:text-5xl font-bold mb-4 text-multilang">{event.title}</h1>

                <div class="flex flex-wrap gap-4 items-center text-white/90">
                    <div class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span>{formatDate(event.date, lang)}</span>
                    </div>
                    {event.time && (
                        <div class="flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span>{event.time}</span>
                        </div>
                    )}
                    <div class="flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <span class="text-multilang">{event.location}</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Event Content -->
        <section class="py-12 bg-white">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-3 gap-8">
                    <!-- Main Content -->
                    <div class="lg:col-span-2">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 text-multilang">{ui.about_event}</h2>
                        <p class="text-gray-700 leading-relaxed mb-8 text-multilang">{event.description}</p>

                        <!-- Tags -->
                        {event.tags && event.tags.length > 0 && (
                            <div class="mb-8">
                                <div class="flex flex-wrap gap-2">
                                    {event.tags.map((tag: string) => (
                                        <span class="bg-gray-100 text-gray-700 text-sm px-3 py-1 rounded-full">
                                            #{tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Impact Section (for past events) -->
                        {event.impact_items && event.impact_items.length > 0 && (
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-4 text-multilang">{ui.event_impact}</h3>
                                <div class="grid grid-cols-3 gap-4">
                                    {event.impact_items.map((item: any) => (
                                        <div class="text-center bg-blue-50 rounded-lg p-4">
                                            <div class="text-2xl font-bold text-blue-700">{item.value}</div>
                                            <div class="text-sm text-gray-600 text-multilang">{item.label}</div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Gallery (for past events) -->
                        {event.gallery && event.gallery.length > 0 && (
                            <div class="mb-8">
                                <h3 class="text-xl font-bold text-gray-900 mb-4">{ui.view_photos}</h3>
                                <div class="grid grid-cols-3 gap-3">
                                    {event.gallery.map((img: string, index: number) => (
                                        <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden cursor-pointer hover:opacity-90 transition-opacity" data-gallery-index={index}>
                                            <img src={img} alt={`${event.title} - Photo ${index + 1}`} class="w-full h-full object-cover" loading="lazy" />
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Share -->
                        <div class="border-t border-gray-200 pt-6">
                            <button id="share-btn" class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                                <span class="text-multilang">{ui.share_event}</span>
                            </button>
                        </div>
                    </div>

                    <!-- Sidebar -->
                    <div class="lg:col-span-1">
                        <div class="bg-gray-50 rounded-xl p-6 sticky top-24">
                            <h3 class="text-lg font-bold text-gray-900 mb-4 text-multilang">{ui.event_details}</h3>

                            <div class="space-y-4">
                                <div>
                                    <div class="text-sm font-medium text-gray-500 text-multilang">{ui.date_label}</div>
                                    <div class="text-gray-900">{formatDate(event.date, lang)}</div>
                                    {event.end_date && <div class="text-gray-600 text-sm">— {formatDate(event.end_date, lang)}</div>}
                                </div>

                                {event.time && (
                                    <div>
                                        <div class="text-sm font-medium text-gray-500 text-multilang">{ui.time_label}</div>
                                        <div class="text-gray-900">{event.time}</div>
                                    </div>
                                )}

                                <div>
                                    <div class="text-sm font-medium text-gray-500 text-multilang">{ui.location_label}</div>
                                    <div class="text-gray-900 text-multilang">{event.location}</div>
                                </div>

                                <div>
                                    <div class="text-sm font-medium text-gray-500 text-multilang">{ui.organizer_label}</div>
                                    <div class="text-gray-900 text-multilang">{event.organizer || event.organizer_name}</div>
                                </div>

                                {event.price !== undefined && (
                                    <div>
                                        <div class="text-sm font-medium text-gray-500 text-multilang">{ui.price_label}</div>
                                        <div class="text-2xl font-bold text-gray-900">
                                            {event.price === 0 ? ui.free : `₹${event.price}`}
                                        </div>
                                    </div>
                                )}

                                {event.capacity !== undefined && (
                                    <div>
                                        <div class="text-sm font-medium text-gray-500 text-multilang">{ui.spots_available}</div>
                                        <div class="text-gray-900">{event.capacity - event.registered} / {event.capacity}</div>
                                        <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
                                            <div class="bg-blue-600 h-2 rounded-full" style={`width: ${(event.registered / event.capacity) * 100}%`}></div>
                                        </div>
                                    </div>
                                )}

                                {event.participants !== undefined && (
                                    <div>
                                        <div class="text-sm font-medium text-gray-500 text-multilang">{ui.participants}</div>
                                        <div class="text-gray-900">{event.participants}</div>
                                    </div>
                                )}
                            </div>

                            {!isPast && event.price !== undefined && (
                                <div class="mt-6">
                                    <button class={`w-full ${getCategoryButton(event.category)} text-white py-3 rounded-lg font-semibold transition-colors text-multilang`} disabled={event.capacity - event.registered === 0}>
                                        {(event.capacity - event.registered) === 0 ? ui.sold_out :
                                         event.price === 0 ? ui.register_free : `${ui.book_now} ₹${event.price}`}
                                    </button>
                                </div>
                            )}

                            <!-- Contact Info -->
                            {(event.contact_email || event.contact_phone || event.contact_whatsapp) && (
                                <div class="mt-6 pt-6 border-t border-gray-200">
                                    <div class="text-sm font-medium text-gray-500 mb-3 text-multilang">{ui.contact_label}</div>
                                    <div class="space-y-2">
                                        {event.contact_email && (
                                            <a href={`mailto:${event.contact_email}`} class="flex items-center text-sm text-blue-600 hover:text-blue-700">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                                {event.contact_email}
                                            </a>
                                        )}
                                        {event.contact_phone && (
                                            <a href={`tel:${event.contact_phone}`} class="flex items-center text-sm text-blue-600 hover:text-blue-700">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                                {event.contact_phone}
                                            </a>
                                        )}
                                        {event.contact_whatsapp && (
                                            <a href={event.contact_whatsapp} class="flex items-center text-sm text-green-600 hover:text-green-700" target="_blank" rel="noopener noreferrer">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                                                WhatsApp
                                            </a>
                                        )}
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />

    <!-- Share Button Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const shareBtn = document.getElementById('share-btn');
            if (!shareBtn) return;

            shareBtn.addEventListener('click', async () => {
                const title = document.querySelector('h1')?.textContent || '';
                const url = window.location.href;

                if (navigator.share) {
                    try {
                        await navigator.share({ title, url });
                    } catch (e) {
                        // User cancelled share
                    }
                } else {
                    await navigator.clipboard.writeText(url);
                    const original = shareBtn.innerHTML;
                    shareBtn.innerHTML = '✓ Copied!';
                    setTimeout(() => { shareBtn.innerHTML = original; }, 2000);
                }
            });
        });
    </script>
</Layout>
