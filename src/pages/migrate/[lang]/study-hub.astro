---
import { getEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getLocalizedPath, type Language } from "../../../i18n";

export async function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "hi" } },
        // Add other languages as needed
    ];
}

const { lang } = Astro.params;
const currentLang = lang as Language;

const entry = await getEntry("study_hub_page", currentLang);

if (!entry) {
    return Astro.redirect("/404");
}

const { data } = entry;

// Helper function to map icon strings to SVG paths or components
const getIconPath = (iconName: string) => {
    switch (iconName) {
        case "historical":
            return "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z";
        case "scriptures":
            return "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253";
        case "research":
            return "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z";
        case "slideshows":
            return "M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m0 0V1a1 1 0 011-1h2a1 1 0 011 1v18a1 1 0 01-1 1H4a1 1 0 01-1-1V1a1 1 0 011-1h2a1 1 0 011 1v3m0 0h8m-8 0V4a1 1 0 011-1h6a1 1 0 011 1v0";
        case "maps":
            return "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 4m0 13V4m0 0L9 7";
        case "multimedia":
            return "M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z";
        case "handbooks":
            return "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253";
        case "rituals":
            return "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z";
        case "calendar":
            return "M8 7V3a1 1 0 011-1h6a1 1 0 011 1v4m-6 0h6m-6 0V7a1 1 0 00-1 1v10a1 1 0 001 1h8a1 1 0 001-1V8a1 1 0 00-1-1h-1";
        default:
            return "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z";
    }
};

const getColorClasses = (
    color: string,
    type:
        | "bg-light"
        | "bg-dark"
        | "text"
        | "border"
        | "hover-border"
        | "group-hover-text"
        | "group-hover-bg",
) => {
    const colors: Record<string, Record<string, string>> = {
        blue: {
            "bg-light": "bg-blue-100",
            "bg-dark": "bg-blue-500",
            text: "text-blue-600",
            border: "border-blue-200",
            "hover-border": "hover:border-blue-300",
            "group-hover-text": "group-hover:text-blue-700",
            "group-hover-bg": "group-hover:bg-blue-200",
        },
        green: {
            "bg-light": "bg-green-100",
            "bg-dark": "bg-green-500",
            text: "text-green-600",
            border: "border-green-200",
            "hover-border": "hover:border-green-300",
            "group-hover-text": "group-hover:text-green-700",
            "group-hover-bg": "group-hover:bg-green-200",
        },
        orange: {
            "bg-light": "bg-orange-100",
            "bg-dark": "bg-orange-500",
            text: "text-orange-600",
            border: "border-orange-200",
            "hover-border": "hover:border-orange-300",
            "group-hover-text": "group-hover:text-orange-700",
            "group-hover-bg": "group-hover:bg-orange-200",
        },
        purple: {
            "bg-light": "bg-purple-100",
            "bg-dark": "bg-purple-500",
            text: "text-purple-600",
            border: "border-purple-200",
            "hover-border": "hover:border-purple-300",
            "group-hover-text": "group-hover:text-purple-700",
            "group-hover-bg": "group-hover:bg-purple-200",
        },
        amber: {
            "bg-light": "bg-amber-100",
            "bg-dark": "bg-amber-500",
            text: "text-amber-600",
            border: "border-amber-200",
            "hover-border": "hover:border-amber-300",
            "group-hover-text": "group-hover:text-amber-700",
            "group-hover-bg": "group-hover:bg-amber-200",
        },
        pink: {
            "bg-light": "bg-pink-100",
            "bg-dark": "bg-pink-500",
            text: "text-pink-600",
            border: "border-pink-200",
            "hover-border": "hover:border-pink-300",
            "group-hover-text": "group-hover:text-pink-700",
            "group-hover-bg": "group-hover:bg-pink-200",
        },
        red: {
            "bg-light": "bg-red-100",
            "bg-dark": "bg-red-500",
            text: "text-red-600",
            border: "border-red-200",
            "hover-border": "hover:border-red-300",
            "group-hover-text": "group-hover:text-red-700",
            "group-hover-bg": "group-hover:bg-red-200",
        },
        indigo: {
            "bg-light": "bg-indigo-100",
            "bg-dark": "bg-indigo-500",
            text: "text-indigo-600",
            border: "border-indigo-200",
            "hover-border": "hover:border-indigo-300",
            "group-hover-text": "group-hover:text-indigo-700",
            "group-hover-bg": "group-hover:bg-indigo-200",
        },
        emerald: {
            "bg-light": "bg-emerald-100",
            "bg-dark": "bg-emerald-500",
            text: "text-emerald-600",
            border: "border-emerald-200",
            "hover-border": "hover:border-emerald-300",
            "group-hover-text": "group-hover:text-emerald-700",
            "group-hover-bg": "group-hover:bg-emerald-200",
        },
    };
    return colors[color]?.[type] || "";
};

const getMigratedLink = (path: string, lang: string) => {
    return `/migrate/${lang}${path}`;
};
---

<Layout title={data.title} description={data.description} lang={currentLang}>
    <Header />

    <main class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
        <!-- Page Header -->
        <section
            class="py-16 bg-gradient-to-r from-teal-500 to-blue-600 text-white"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <div class="flex justify-center mb-6">
                        <div
                            class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center"
                        >
                            <svg
                                class="w-10 h-10 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                ></path>
                            </svg>
                        </div>
                    </div>
                    <h1 class="text-4xl md:text-6xl font-bold mb-6">
                        {data.hero.title}
                    </h1>
                    <p
                        class="text-xl md:text-2xl mb-8 text-blue-100 max-w-4xl mx-auto"
                    >
                        {data.hero.description}
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a
                            href="#resources"
                            class="bg-white text-sky-600 px-8 py-3 rounded-lg font-semibold hover:bg-sky-50 transition-all transform hover:scale-105"
                        >
                            {data.hero.browse_button}
                        </a>
                        <a
                            href="#contribute"
                            class="bg-sky-800 text-white px-8 py-3 rounded-lg font-semibold hover:bg-sky-900 transition-all border border-sky-500"
                        >
                            {data.hero.contribute_button}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Stats -->
        <section class="py-12 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    {
                        data.stats_section.map((stat) => (
                            <div>
                                <div
                                    class={`text-3xl font-bold mb-2 ${getColorClasses(stat.color, "text")}`}
                                >
                                    {stat.value}
                                </div>
                                <div class="text-gray-600">{stat.label}</div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Search Section -->
        <section class="py-16 bg-gradient-to-br from-teal-500 to-blue-600">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                    {data.search_section.title}
                </h2>
                <p class="text-xl text-teal-100 mb-8">
                    {data.search_section.description}
                </p>

                <div class="relative max-w-2xl mx-auto">
                    <input
                        type="text"
                        placeholder={data.search_section.placeholder}
                        class="w-full px-6 py-4 pr-12 text-lg rounded-lg border-0 focus:ring-4 focus:ring-white/30 focus:outline-none shadow-lg"
                    />
                    <button
                        class="absolute right-2 top-2 bg-teal-500 text-white p-2 rounded-lg hover:bg-teal-600 transition-colors"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                    </button>
                </div>

                <div class="mt-6 flex flex-wrap justify-center gap-2">
                    <span class="text-teal-100 text-sm"
                        >{data.search_section.popular_topics.label}</span
                    >
                    {
                        data.search_section.popular_topics.topics.map(
                            (topic) => (
                                <a
                                    href={getMigratedLink(
                                        topic.href,
                                        currentLang,
                                    )}
                                    class="bg-white/20 text-white px-3 py-1 rounded-full text-sm hover:bg-white/30 transition-colors"
                                >
                                    {topic.label}
                                </a>
                            ),
                        )
                    }
                </div>
            </div>
        </section>

        <!-- Study Categories -->
        <section id="resources" class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        {data.categories_section.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {data.categories_section.description}
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {
                        data.categories_section.categories.map((category) => (
                            <a
                                href={getMigratedLink(
                                    category.href,
                                    currentLang,
                                )}
                                class={`group bg-white rounded-lg border p-6 hover:shadow-lg transition-all duration-200 border-gray-200 ${category.status ? "opacity-75 grayscale" : ""} ${getColorClasses(category.color, "hover-border")}`}
                            >
                                <div class="flex items-start space-x-4">
                                    <div class="flex-shrink-0">
                                        <div
                                            class={`w-12 h-12 rounded-lg flex items-center justify-center transition-colors ${getColorClasses(category.color, "bg-light")} ${getColorClasses(category.color, "group-hover-bg")}`}
                                        >
                                            <svg
                                                class={`w-6 h-6 ${getColorClasses(category.color, "text")}`}
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d={getIconPath(
                                                        category.icon,
                                                    )}
                                                />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3
                                            class={`text-lg font-semibold text-gray-900 transition-colors ${getColorClasses(category.color, "group-hover-text")}`}
                                        >
                                            {category.title}
                                        </h3>
                                        <p class="text-sm text-gray-600 mt-1 mb-3">
                                            {category.description}
                                        </p>
                                        <div class="flex items-center text-xs text-gray-500">
                                            <span class="bg-gray-100 px-2 py-1 rounded mr-2">
                                                {category.stats}
                                            </span>
                                            {category.status ? (
                                                <span class="text-red-500">
                                                    {category.status}
                                                </span>
                                            ) : (
                                                <span>
                                                    {category.last_updated}
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                    <div class="flex-shrink-0">
                                        <svg
                                            class={`w-5 h-5 text-gray-400 transition-colors ${getColorClasses(category.color, "group-hover-text")}`}
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 5l7 7-7 7"
                                            />
                                        </svg>
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Featured Resources -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        {data.featured_resources.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {data.featured_resources.description}
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {
                        data.featured_resources.resources.map((resource) => (
                            <div
                                class={`rounded-lg p-6 border ${getColorClasses(resource.color, "border")} bg-gradient-to-br from-${resource.color}-50 to-indigo-100`}
                            >
                                <div class="flex items-center mb-4">
                                    <div
                                        class={`w-12 h-12 rounded-lg flex items-center justify-center mr-4 ${getColorClasses(resource.color, "bg-dark")}`}
                                    >
                                        <svg
                                            class="w-6 h-6 text-white"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d={
                                                    resource.title.includes(
                                                        "Audio",
                                                    )
                                                        ? "M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                                                        : "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                                }
                                            />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-gray-900">
                                            {resource.title}
                                        </h3>
                                        <p class="text-sm text-gray-600">
                                            {resource.type}
                                        </p>
                                    </div>
                                </div>
                                <p class="text-gray-700 text-sm mb-4">
                                    {resource.description}
                                </p>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-gray-500">
                                        {resource.added}
                                    </span>
                                    <a
                                        href={resource.file_path}
                                        target="_blank"
                                        class={`text-sm font-medium hover:underline ${getColorClasses(resource.color, "text")}`}
                                    >
                                        {resource.download_text}
                                    </a>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Contribute Section -->
        <section
            id="contribute"
            class="py-16 bg-gradient-to-br from-orange-50 to-red-100"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        {data.contribute_section.title}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-3xl mx-auto">
                        {data.contribute_section.description}
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-12 items-center">
                    <div>
                        <h3 class="text-2xl font-bold text-gray-900 mb-6">
                            {data.contribute_section.how_to_contribute.title}
                        </h3>
                        <div class="space-y-6">
                            {
                                data.contribute_section.how_to_contribute.methods.map(
                                    (method) => (
                                        <div class="flex items-start">
                                            <div class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center mr-4 mt-1">
                                                <svg
                                                    class="w-4 h-4 text-white"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 4v16m8-8H4"
                                                    />
                                                </svg>
                                            </div>
                                            <div>
                                                <h4 class="font-semibold text-gray-900 mb-2">
                                                    {method.title}
                                                </h4>
                                                <p class="text-gray-600">
                                                    {method.description}
                                                </p>
                                            </div>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                    </div>

                    <div class="bg-white rounded-xl shadow-lg p-8">
                        <h3 class="text-xl font-bold text-gray-900 mb-6">
                            {data.contribute_section.submission_form.title}
                        </h3>
                        <form class="space-y-4">
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.name
                                    }</label
                                >
                                <input
                                    type="text"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                                    placeholder={data.contribute_section
                                        .submission_form.fields.name}
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.email
                                    }</label
                                >
                                <input
                                    type="email"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                                    placeholder={data.contribute_section
                                        .submission_form.fields.email}
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.type
                                    }</label
                                >
                                <select
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                                >
                                    {
                                        data.contribute_section.submission_form.contribution_types.map(
                                            (type) => <option>{type}</option>,
                                        )
                                    }
                                </select>
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.related_rivers
                                    }</label
                                >
                                <input
                                    type="text"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                                    placeholder="e.g., Ganga, Yamuna"
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.description
                                    }</label
                                >
                                <textarea
                                    rows="4"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                                    placeholder={data.contribute_section
                                        .submission_form.fields.description}
                                ></textarea>
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-2"
                                    >{
                                        data.contribute_section.submission_form
                                            .fields.upload_files
                                    }</label
                                >
                                <div
                                    class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center"
                                >
                                    <svg
                                        class="w-8 h-8 text-gray-400 mx-auto mb-2"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                                        ></path>
                                    </svg>
                                    <p class="text-gray-600">
                                        {
                                            data.contribute_section
                                                .submission_form.fields
                                                .upload_hint
                                        }
                                    </p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        {
                                            data.contribute_section
                                                .submission_form.fields
                                                .upload_formats
                                        }
                                    </p>
                                </div>
                            </div>
                            <button
                                type="submit"
                                class="w-full bg-gradient-to-r from-orange-500 to-red-500 text-white py-3 px-6 rounded-lg font-semibold hover:from-orange-600 hover:to-red-600 transition-all"
                            >
                                {
                                    data.contribute_section.submission_form
                                        .submit_button
                                }
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- Community Guidelines -->
        <section class="py-16 bg-white">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-gray-900 mb-4">
                        {data.guidelines_section.title}
                    </h2>
                    <p class="text-lg text-gray-600">
                        {data.guidelines_section.description}
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <div
                        class="bg-green-50 p-6 rounded-lg border border-green-200"
                    >
                        <h3
                            class="text-lg font-semibold text-green-800 mb-4 flex items-center"
                        >
                            <svg
                                class="w-5 h-5 text-green-600 mr-2"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            {data.guidelines_section.accepted.title}
                        </h3>
                        <ul class="space-y-2 text-green-700 text-sm">
                            {
                                data.guidelines_section.accepted.list.map(
                                    (item) => <li>• {item}</li>,
                                )
                            }
                        </ul>
                    </div>

                    <div class="bg-red-50 p-6 rounded-lg border border-red-200">
                        <h3
                            class="text-lg font-semibold text-red-800 mb-4 flex items-center"
                        >
                            <svg
                                class="w-5 h-5 text-red-600 mr-2"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            {data.guidelines_section.not_accepted.title}
                        </h3>
                        <ul class="space-y-2 text-red-700 text-sm">
                            {
                                data.guidelines_section.not_accepted.list.map(
                                    (item) => <li>• {item}</li>,
                                )
                            }
                        </ul>
                    </div>
                </div>

                <div
                    class="mt-8 bg-blue-50 p-6 rounded-lg border border-blue-200"
                >
                    <h3 class="text-lg font-semibold text-blue-800 mb-4">
                        {data.guidelines_section.review_process.title}
                    </h3>
                    <div class="grid md:grid-cols-4 gap-4 text-sm">
                        {
                            data.guidelines_section.review_process.steps.map(
                                (step, index) => (
                                    <div class="text-center">
                                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-2">
                                            <span class="text-white font-bold text-xs">
                                                {index + 1}
                                            </span>
                                        </div>
                                        <p class="text-blue-700">{step}</p>
                                    </div>
                                ),
                            )
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Newsletter Section -->
        <section
            class="py-16 bg-gradient-to-r from-blue-600 to-indigo-700 text-white"
        >
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h2 class="text-3xl font-bold mb-4">
                    {data.newsletter_section.title}
                </h2>
                <p class="text-blue-100 mb-8 text-lg">
                    {data.newsletter_section.description}
                </p>
                <form
                    class="flex flex-col sm:flex-row gap-4 justify-center max-w-lg mx-auto"
                >
                    <input
                        type="email"
                        placeholder={data.newsletter_section.email_placeholder}
                        class="px-6 py-3 rounded-lg text-gray-900 focus:ring-2 focus:ring-white focus:outline-none flex-grow"
                        required
                    />
                    <button
                        type="submit"
                        class="bg-white text-blue-600 px-8 py-3 rounded-lg font-bold hover:bg-blue-50 transition-colors"
                    >
                        {data.newsletter_section.subscribe_button}
                    </button>
                </form>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
