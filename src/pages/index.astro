---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLanguageFromURL, getLocalizedPath } from "../i18n";
import {
  BookOpen,
  Headphones,
  MessageCircle,
  ArrowRight,
  CircleQuestionMark,
  Map,
  Youtube,
} from "lucide-react";

const currentLang = "en";
---

<Layout
  title="Nadi Stuti - Coming Soon"
  description="We are building a digital tribute to the sacred rivers of India."
  lang={currentLang}
>
  <!-- <Header /> -->

  <main
    class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-orange-50 flex items-center justify-center px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- Sacred River Wave Animation -->
      <div class="mb-8 relative">
        <div class="w-32 h-32 mx-auto mb-6 relative">
          <!-- Animated water ripples -->
          <div
            class="absolute inset-0 rounded-full bg-gradient-to-r from-blue-400 to-blue-600 opacity-20 animate-ping"
          >
          </div>
          <div
            class="absolute inset-2 rounded-full bg-gradient-to-r from-blue-500 to-blue-700 opacity-30 animate-ping animation-delay-200"
          >
          </div>
          <div
            class="absolute inset-4 rounded-full bg-gradient-to-r from-blue-600 to-blue-800 opacity-40 animate-ping animation-delay-400"
          >
          </div>

          <!-- Sacred Om symbol in center -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div
              class="w-16 h-16 bg-gradient-to-r from-blue-600 to-orange-500 rounded-full flex items-center justify-center shadow-lg"
            >
              <span class="text-white font-bold text-2xl font-sanskrit">ॐ</span>
            </div>
          </div>
        </div>

        <!-- Flowing river SVG -->
        <div
          class="absolute top-20 left-1/2 transform -translate-x-1/2 w-96 h-24 opacity-30 pointer-events-none"
        >
          <svg viewBox="0 0 400 100" class="w-full h-full">
            <path
              d="M0,50 Q100,20 200,50 T400,50"
              stroke="url(#riverGradient)"
              stroke-width="3"
              fill="none"
              class="animate-pulse"
            >
              <animate
                attributeName="d"
                values="M0,50 Q100,20 200,50 T400,50;M0,50 Q100,80 200,50 T400,50;M0,50 Q100,20 200,50 T400,50"
                dur="4s"
                repeatCount="indefinite"></animate>
            </path>
            <defs>
              <linearGradient
                id="riverGradient"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="0%"
              >
                <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1"
                ></stop>
                <stop offset="50%" style="stop-color:#06B6D4;stop-opacity:1"
                ></stop>
                <stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1"
                ></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>

      <!-- Content -->
      <div class="mb-12">
        <h1
          class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 font-serif tracking-tight"
        >
          Nadi Stuti
        </h1>
        <h2
          class="text-2xl md:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-orange-500 mb-6"
        >
          A Tribute to the Sacred Rivers
        </h2>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto leading-relaxed">
          We are crafting a digital sanctuary to honor the eternal flow of
          India's rivers. This journey along the sacred waters is coming soon.
        </p>

        <!-- YouTube Explainer Video -->
        <div class="max-w-3xl mx-auto mb-16">
          <div class="relative group">
            <!-- Decorative background glow -->
            <div
              class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-orange-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"
            >
            </div>

            <div
              class="relative bg-white rounded-2xl overflow-hidden shadow-2xl border border-blue-100/30 backdrop-blur-md"
            >
              <div class="aspect-video w-full h-full bg-gray-100">
                <iframe
                  src="https://www.youtube.com/embed/qgCoxhVn4ek"
                  title="Nadi Stuti - Path to Conservation"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                  class="w-full h-full"></iframe>
              </div>
            </div>
          </div>

          <div class="mt-8 text-center max-w-2xl mx-auto">
            <p class="text-lg text-gray-700 leading-relaxed font-serif italic">
              "In this video we are giving a detailed introduction to our river
              conservation platform with Nadistuti and Nadikosh, exploring our
              mission to preserve the sacred life-lines of India."
            </p>
            <div
              class="w-16 h-1 bg-gradient-to-r from-blue-400 to-orange-400 mx-auto mt-6 rounded-full opacity-40"
            >
            </div>
          </div>
        </div>

        <div class="flex flex-col items-center gap-4">
          <span
            class="px-4 py-1.5 bg-blue-50 text-blue-700 text-xs font-bold tracking-widest uppercase rounded-full border border-blue-100"
          >
            Work in Progress
          </span>
          <p class="text-sm text-gray-400">Stay tuned for the unveiling</p>
        </div>

        <div class="flex flex-col items-center gap-4 mt-2">
          <a
            href="/en/select-lang"
            rel="noopener noreferrer"
            class="flex gap-2 px-4 py-1.5 bg-red-50 text-red-700 font-bold uppercase rounded-2 border border-red-100 mt-5 hover:bg-red-100 hover:border-red-200 transition-colors group/btn"
          >
            View demo website
            <ArrowRight
              className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
            />
          </a>
        </div>

        <!-- Resources Section -->
        <div class="mt-16">
          <p
            class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed"
          >
            While we build here, we invite you to explore
          </p>

          <div class="grid gap-6 md:grid-cols-3 text-left">
            <!-- Nadikosh -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-blue-50 hover:shadow-md hover:border-blue-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <BookOpen className="w-6 h-6 text-blue-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Nadikosh
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Dive into the sacred history, geography, and spiritual
                significance of our holy rivers through our comprehensive
                knowledge repository.
              </p>
              <a
                href="https://kosh.nadistuti.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-blue-200 text-blue-700 text-sm font-semibold rounded-lg hover:bg-blue-50 hover:border-blue-300 transition-colors gap-2 group/btn"
              >
                Explore Knowledge
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>

            <!-- Katha -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-orange-50 hover:shadow-md hover:border-orange-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <Headphones className="w-6 h-6 text-orange-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Brahmalok
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Immerse yourself in divine storytelling. Listen to enchanting
                tales of the rivers narrated by the divine voices of Brahma and
                Ma Saraswati themselves.
              </p>
              <a
                href="https://katha.nadistuti.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-orange-200 text-orange-700 text-sm font-semibold rounded-lg hover:bg-orange-50 hover:border-orange-300 transition-colors gap-2 group/btn"
              >
                Listen to Katha
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>

            <!-- Quiz -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-purple-50 hover:shadow-md hover:border-purple-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <CircleQuestionMark className="w-6 h-6 text-purple-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Gyan Pravah
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Test your wisdom across various paths of Sanatan Dharma. From
                basic legends to deep Vedantic philosophy, challenge yourself
                with our tiered difficulties.
              </p>
              <a
                href="https://gyan-pravah.nadistuti.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-purple-200 text-purple-700 text-sm font-semibold rounded-lg hover:bg-purple-50 hover:border-purple-300 transition-colors gap-2 group/btn"
              >
                Start the Quiz
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>

            <!-- Interactive River Map -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-cyan-50 hover:shadow-md hover:border-cyan-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-cyan-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <Map className="w-6 h-6 text-cyan-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Interactive River Map
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Explore the lifelines of India through our immersive, interactive river map. Visualize river courses, discover key points of interest, and engage with our AI guide for deeper insights.
              </p>
              <a
                href="https://interactive-rivermap.netlify.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-cyan-200 text-cyan-700 text-sm font-semibold rounded-lg hover:bg-cyan-50 hover:border-cyan-300 transition-colors gap-2 group/btn"
              >
                View Map
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>

            <!-- Nadi Pathshala (YouTube Playlist) -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-rose-50 hover:shadow-md hover:border-rose-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-rose-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <Youtube className="w-6 h-6 text-rose-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Nadi Pathshala
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Discover the wonders of our rivers through bite-sized lessons. Our curated YouTube shorts playlist offers quick, insightful 1-minute videos to educate and inspire river conservation.
              </p>
              <a
                href="https://youtube.com/playlist?list=PLtLhNNQ8GvwmAtfqIlh-N8m2b0NdUh0YZ&si=lt7fHL26yol6L8SU"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-rose-200 text-rose-700 text-sm font-semibold rounded-lg hover:bg-rose-50 hover:border-rose-300 transition-colors gap-2 group/btn"
              >
                Watch Playlist
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>

            <!-- Sabha -->
            <div
              class="group bg-white rounded-2xl p-6 shadow-sm border border-green-50 hover:shadow-md hover:border-green-100 transition-all duration-300"
            >
              <div
                class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
              >
                <MessageCircle className="w-6 h-6 text-green-600" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2 font-serif">
                Nadi Stuti Sabha
              </h3>
              <p class="text-sm text-gray-600 mb-6 leading-relaxed">
                Join our WhatsApp community. Be part of our growing movement,
                discuss river conservation, and help us empower the cause
                together.
              </p>
              <a
                href="https://chat.whatsapp.com/GWWZngBJzYsDZ8AGzF6Xt4"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-white border border-green-200 text-green-700 text-sm font-semibold rounded-lg hover:bg-green-50 hover:border-green-300 transition-colors gap-2 group/btn"
              >
                Join Community
                <ArrowRight
                  className="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- <Footer /> -->
</Layout>

<script async src="https://www.googletagmanager.com/gtag/js?id=G-BP9S9G6BRB"
></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-BP9S9G6BRB");
</script>

<style>
  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>
