---
interface Props {
  riverName: string;
  riverSlug: string;
  snippet: string;
  currentLang: string;
}

const { riverName, riverSlug, snippet, currentLang } = Astro.props;

const siteBase = 'https://nadistuti.com';
const pageUrl  = `${siteBase}/${currentLang}/rivers/${riverSlug}/`;
const shortUrl = `nadistuti.com/${currentLang}/rivers/${riverSlug}/`;
const shareText = `Why ${riverName} is Sacred:\n\n"${snippet}"\n\nRead the full story:`;

const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText + ' ' + pageUrl)}`;
const twitterUrl  = `https://x.com/intent/tweet?text=${encodeURIComponent(`Why ${riverName} is Sacred — "${snippet}"`)}&url=${encodeURIComponent(pageUrl)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;

const canvasId = `river-card-${riverSlug}`;
---

<!-- Share River -->
<section class="river-share-section text-center">
  <div class="share-card-inner">
    <!-- Decorative ripples -->
    <div class="ripple ripple-1" aria-hidden="true"></div>
    <div class="ripple ripple-2" aria-hidden="true"></div>
    <div class="ripple ripple-3" aria-hidden="true"></div>

    <div class="share-content">

      <!-- Badge -->
      <div class="share-badge">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        Share This Sacred River
      </div>

      <!-- Snippet Card Canvas -->
      <div class="card-preview-wrapper">
        <canvas
          id={canvasId}
          class="snippet-canvas"
          data-river={riverName}
          data-snippet={snippet}
          data-short-url={shortUrl}
        ></canvas>

        <!-- Save + Share Image row -->
        <div class="card-actions">
          <button class="save-card-btn" data-canvas={canvasId} data-river={riverName}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon-sm">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span class="save-label">Save Card as Image</span>
          </button>

          <!-- Native share with image on supported devices -->
          <button class="share-img-btn" style="display:none"
            data-canvas={canvasId}
            data-river={riverName}
            data-url={pageUrl}
            aria-label="Share card image via app">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon-sm">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            Share Image
          </button>
        </div>

        <p class="card-hint">
          Save the card and share it on Instagram, WhatsApp, or anywhere images work.
        </p>
      </div>

      <!-- Read more link -->
      <a href={pageUrl} class="read-more-btn" target="_blank" rel="noopener">
        Read the Full Story
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Share label -->
      <p class="share-label">Share the link with your community</p>

      <!-- Share buttons -->
      <div class="share-buttons">

        <!-- WhatsApp -->
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
          class="share-btn whatsapp" aria-label="Share on WhatsApp">
          <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          WhatsApp
        </a>

        <!-- X / Twitter -->
        <a href={twitterUrl} target="_blank" rel="noopener noreferrer"
          class="share-btn twitter" aria-label="Share on X">
          <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          Post on X
        </a>

        <!-- Facebook -->
        <a href={facebookUrl} target="_blank" rel="noopener noreferrer"
          class="share-btn facebook" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          Facebook
        </a>

        <!-- Copy Link -->
        <button class="share-btn copy-link-btn"
          data-url={pageUrl}
          aria-label="Copy link to clipboard">
          <svg viewBox="0 0 24 24" class="btn-icon" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span class="copy-label">Copy Link</span>
        </button>

        <!-- Native Share URL (shown only when Web Share API is available) -->
        <button class="share-btn native-share-btn" style="display:none"
          data-url={pageUrl}
          data-title={`${riverName} — Sacred River of India | Nadi Stuti`}
          data-text={`${shareText} ${pageUrl}`}
          aria-label="Share via app">
          <svg viewBox="0 0 24 24" class="btn-icon" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          More Apps
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  // ─── Canvas drawing ─────────────────────────────────────────────────────────
  function wrapText(
    ctx: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number
  ): number {
    const words = text.split(' ');
    let line = '';
    let count = 0;
    for (let i = 0; i < words.length; i++) {
      const test = line + words[i] + ' ';
      if (ctx.measureText(test).width > maxWidth && i > 0) {
        ctx.fillText(line.trim(), x, y + count * lineHeight);
        line = words[i] + ' ';
        count++;
      } else {
        line = test;
      }
    }
    ctx.fillText(line.trim(), x, y + count * lineHeight);
    return count + 1;
  }

  function drawCard(canvas: HTMLCanvasElement) {
    const S   = 1080;
    canvas.width  = S;
    canvas.height = S;
    const ctx = canvas.getContext('2d')!;

    const riverName = canvas.dataset.river    || '';
    const snippet   = canvas.dataset.snippet  || '';
    const shortUrl  = canvas.dataset.shortUrl || '';

    // Background gradient
    const bg = ctx.createLinearGradient(0, 0, S, S);
    bg.addColorStop(0,   '#0f0c29');
    bg.addColorStop(0.5, '#302b63');
    bg.addColorStop(1,   '#24243e');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, S, S);

    // Ripple rings — top-right corner
    for (let i = 1; i <= 6; i++) {
      ctx.beginPath();
      ctx.arc(S * 0.9, S * 0.1, 85 * i, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,255,255,0.035)';
      ctx.lineWidth   = 1.5;
      ctx.stroke();
    }

    // Top amber accent bar
    const bar = ctx.createLinearGradient(0, 0, S, 0);
    bar.addColorStop(0,   'rgba(251,191,36,0)');
    bar.addColorStop(0.5, 'rgba(251,191,36,0.9)');
    bar.addColorStop(1,   'rgba(251,191,36,0)');
    ctx.fillStyle = bar;
    ctx.fillRect(0, 0, S, 6);

    // Wave tilde decoration
    ctx.font      = 'bold 54px Georgia, serif';
    ctx.fillStyle = 'rgba(251,191,36,0.6)';
    ctx.textAlign = 'center';
    ctx.fillText('~ ~ ~', S / 2, 112);

    // River name heading
    ctx.font      = 'bold 64px Arial, sans-serif';
    ctx.fillStyle = '#fde68a';
    ctx.textAlign = 'center';
    ctx.fillText(`WHY ${riverName.toUpperCase()} IS SACRED`, S / 2, 206);

    // Divider under heading
    const div = ctx.createLinearGradient(S / 2 - 200, 0, S / 2 + 200, 0);
    div.addColorStop(0,   'rgba(251,191,36,0)');
    div.addColorStop(0.5, 'rgba(251,191,36,0.55)');
    div.addColorStop(1,   'rgba(251,191,36,0)');
    ctx.fillStyle = div;
    ctx.fillRect(S / 2 - 200, 232, 400, 2);

    // Snippet text
    ctx.font      = 'italic 38px Georgia, serif';
    ctx.fillStyle = 'rgba(255,255,255,0.88)';
    ctx.textAlign = 'center';
    const lineCount = wrapText(ctx, `\u201C${snippet}\u201D`, S / 2, 306, S - 200, 60);

    // Branding block
    const brandY = Math.max(306 + lineCount * 60 + 80, S - 220);

    ctx.fillStyle = 'rgba(255,255,255,0.1)';
    ctx.fillRect(100, brandY, S - 200, 1);

    ctx.font      = '28px Arial, sans-serif';
    ctx.fillStyle = 'rgba(255,255,255,0.42)';
    ctx.textAlign = 'center';
    ctx.fillText('Read the full story at', S / 2, brandY + 54);

    ctx.font      = 'bold 34px Arial, sans-serif';
    ctx.fillStyle = '#fde68a';
    ctx.fillText(shortUrl, S / 2, brandY + 100);

    ctx.font      = '22px Arial, sans-serif';
    ctx.fillStyle = 'rgba(255,255,255,0.22)';
    ctx.fillText('NADI STUTI \u2014 Sacred Rivers of India', S / 2, brandY + 148);

    // Bottom amber accent bar
    ctx.fillStyle = bar;
    ctx.fillRect(0, S - 6, S, 6);
  }

  document.querySelectorAll<HTMLCanvasElement>('.snippet-canvas:not([data-drawn])').forEach((canvas) => {
    canvas.setAttribute('data-drawn', 'true');
    drawCard(canvas);
  });

  // ─── Save card as PNG ───────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.save-card-btn:not([data-init])').forEach((btn) => {
    btn.setAttribute('data-init', 'true');
    btn.addEventListener('click', () => {
      const canvasId = btn.dataset.canvas || '';
      const river    = (btn.dataset.river || 'river').toLowerCase();
      const canvas   = document.getElementById(canvasId) as HTMLCanvasElement | null;
      if (!canvas) return;

      const label = btn.querySelector<HTMLElement>('.save-label');
      if (label) label.textContent = 'Saving\u2026';
      btn.disabled = true;

      canvas.toBlob((blob) => {
        if (!blob) { btn.disabled = false; return; }
        const url = URL.createObjectURL(blob);
        const a   = Object.assign(document.createElement('a'), {
          href:     url,
          download: `${river}-sacred-card.png`,
        });
        a.click();
        URL.revokeObjectURL(url);
        if (label) {
          label.textContent = '\u2713 Saved!';
          setTimeout(() => {
            label.textContent = 'Save Card as Image';
            btn.disabled = false;
          }, 2200);
        } else {
          btn.disabled = false;
        }
      }, 'image/png');
    });
  });

  // ─── Share image via Web Share API (mobile) ─────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.share-img-btn:not([data-init])').forEach((btn) => {
    btn.setAttribute('data-init', 'true');
    if (!navigator.share || !navigator.canShare) return;
    // Reveal only if the browser can share files
    const testFile = new File([''], 'test.png', { type: 'image/png' });
    if (!navigator.canShare({ files: [testFile] })) return;

    btn.style.display = '';
    btn.addEventListener('click', async () => {
      const canvasId = btn.dataset.canvas || '';
      const river    = (btn.dataset.river || 'river').toLowerCase();
      const pageUrl  = btn.dataset.url || '';
      const canvas   = document.getElementById(canvasId) as HTMLCanvasElement | null;
      if (!canvas) return;

      canvas.toBlob(async (blob) => {
        if (!blob) return;
        const file = new File([blob], `${river}-sacred-card.png`, { type: 'image/png' });
        try {
          await navigator.share({
            title: `Why ${btn.dataset.river} is Sacred`,
            text:  `Learn about the sacred river ${btn.dataset.river} on Nadi Stuti`,
            files: [file],
          });
        } catch (_) { /* user cancelled */ }
      }, 'image/png');
    });
  });

  // ─── Copy link ──────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.copy-link-btn:not([data-init])').forEach((btn) => {
    btn.setAttribute('data-init', 'true');
    btn.addEventListener('click', async () => {
      const url   = btn.dataset.url || '';
      const label = btn.querySelector<HTMLElement>('.copy-label');
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const el = Object.assign(document.createElement('textarea'), {
          value: url,
          style: 'position:fixed;opacity:0',
        });
        document.body.appendChild(el);
        el.focus();
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
      }
      if (label) {
        const orig = label.textContent;
        label.textContent = '\u2713 Copied!';
        btn.classList.add('copied');
        setTimeout(() => { label.textContent = orig; btn.classList.remove('copied'); }, 2200);
      }
    });
  });

  // ─── Native URL share ───────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.native-share-btn:not([data-init])').forEach((btn) => {
    btn.setAttribute('data-init', 'true');
    if (!navigator.share) return;
    btn.style.display = '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.share({
          title: btn.dataset.title || '',
          text:  btn.dataset.text  || '',
          url:   btn.dataset.url   || '',
        });
      } catch (_) { /* user cancelled */ }
    });
  });
</script>

<style>
  .river-share-section { margin: 0; }

  .share-card-inner {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
    border-radius: 1.25rem;
    padding: 3rem 2rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.4);
  }

  /* Animated ripple rings */
  .ripple {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.08);
    animation: ripple-anim 8s linear infinite;
    pointer-events: none;
  }
  .ripple-1 { width: 300px; height: 300px; top: -100px; left: -100px; animation-delay: 0s; }
  .ripple-2 { width: 500px; height: 500px; top: -200px; right: -200px; animation-delay: -3s; }
  .ripple-3 { width: 200px; height: 200px; bottom: -80px; left: 40%; animation-delay: -6s; }

  @keyframes ripple-anim {
    0%   { transform: scale(1);   opacity: 0.6; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .share-content { position: relative; z-index: 1; }

  /* Badge */
  .share-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fde68a;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.75rem;
  }

  /* Canvas card preview */
  .card-preview-wrapper {
    max-width: 420px;
    margin: 0 auto 2rem;
  }

  .snippet-canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 1rem;
    box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08);
  }

  /* Card action buttons row */
  .card-actions {
    display: flex;
    gap: 0.65rem;
    justify-content: center;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .save-card-btn,
  .share-img-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: transform 0.18s, filter 0.18s;
  }
  .save-card-btn:hover,
  .share-img-btn:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.1);
  }
  .save-card-btn:disabled { opacity: 0.65; cursor: not-allowed; transform: none; filter: none; }

  .save-card-btn  { background: #fde68a; color: #1e1b4b; }
  .share-img-btn  { background: linear-gradient(135deg, #a855f7, #ec4899); color: #fff; }

  .btn-icon-sm { width: 1rem; height: 1rem; flex-shrink: 0; }

  .card-hint {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    margin-top: 0.65rem;
    letter-spacing: 0.02em;
  }

  /* Read more button */
  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    font-weight: 600;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    margin-bottom: 2.5rem;
  }
  .read-more-btn:hover { background: rgba(255,255,255,0.22); transform: translateY(-2px); }

  /* Share label */
  .share-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1rem;
  }

  /* Share buttons row */
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: transform 0.18s, filter 0.18s, background 0.2s;
  }
  .share-btn:hover { transform: translateY(-2px) scale(1.04); filter: brightness(1.1); }

  .btn-icon { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }

  .share-btn.whatsapp { background: #25D366; color: #fff; }
  .share-btn.twitter  { background: #000;    color: #fff; }
  .share-btn.facebook { background: #1877F2; color: #fff; }

  .share-btn.copy-link-btn {
    background: rgba(255,255,255,0.13);
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
  }
  .share-btn.copy-link-btn.copied {
    background: rgba(34,197,94,0.28);
    border-color: rgba(34,197,94,0.5);
  }

  .share-btn.native-share-btn {
    background: linear-gradient(135deg, #a855f7, #ec4899);
    color: #fff;
  }

  @media (max-width: 640px) {
    .share-card-inner { padding: 2rem 1.25rem; }
    .card-preview-wrapper { max-width: 100%; }
    .share-btn { padding: 0.6rem 1rem; font-size: 0.825rem; }
  }
</style>
